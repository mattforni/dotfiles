{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git log:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git cherry-pick:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh api:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh secret list:*)",
      "Bash(gh secret get:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm install)",
      "Bash(npm outdated)",
      "Bash(brew:*)",
      "Bash(brew upgrade:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "WebSearch",
      "Read(//Users/forni/**)",
      "mcp__linear-server__update_issue",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__create_issue",
      "mcp__linear-server__create_comment",
      "mcp__linear-server__get_project",
      "mcp__linear-server__get_user",
      "mcp__linear-server__list_teams",
      "WebFetch(domain:linear.app)",
      "Bash(claude mcp add:*)",
      "Bash(claude mcp remove:*)",
      "Read(//dev/**)",
      "Bash(bundle exec rails:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle:*)",
      "Bash(ruby:*)",
      "Bash(gem install:*)",
      "Bash(bundle-audit:*)",
      "Bash(bundle-audit check:*)",
      "Bash(heroku auth:*)",
      "Bash(RAILS_ENV=test bundle exec rails db:migrate:status)",
      "Bash(rvm use:*)",
      "Bash(source ~/.rvm/scripts/rvm)",
      "Bash(rf)",
      "Bash(source ~/.zshrc)",
      "Bash(pkill:*)",
      "Bash(/bin/rm:*)"
    ],
    "deny": [],
    "ask": []
  }
}
