## ~/.bashrc.functions: included by ~/.bashrc to make life easier
## General functions

## ~/.bashrc.functions: included by ~/.bashrc to make life easier
## General functions

# FINDG
# Function to find files matching a particular pattern and then
# grep through them for another pattern.
# -p (optional) instructs find to search by path instead of name
# $1 (mandatory) specifies a pattern of filename in which to search
# $2 (mandatory) specifies a patter for which to grep
findg() {
  local OPTIND

  BY_PATH=0
  while getopts "p" OPTION; do
    case "$OPTION" in
      p) BY_PATH=1;;
      ?) return;;
    esac
  done
  shift $((OPTIND-1))

  if [[ -z $1 ]]; then
    echo "Must provide a pattern of file in which to search"
    return
  fi

  if [[ -z $2 ]]; then
    echo "Must provide a pattern for which to grep"
    return
  fi

  FIND_BY="-name"
  if [ $BY_PATH -eq 1 ]; then
    FIND_BY="-path"
  fi
  find -L . $FIND_BY "$1" | xargs grep -rn "$2"
}

# DOCKER-ATTACH
# Function to attach to a docker process by ID
# $1 (mandatory) specifies the ID of the container
docker-attach() {
  if [[ -z $1 ]]; then
    echo "Must provide an ID of a containter to attach"
    return
  fi

  ID="$1"
  echo "Attaching to container '$ID'"
  docker exec -it $ID /bin/bash
}

# DOCKER-KILL
# Function to kill a docker process by name
# $1 (mandatory) specifies the name of the process(es) to kill
docker-kill() {
  if [[ -z $1 ]]; then
    echo "Must provide a name of the process(es) to kill"
    return
  fi

  NAME="$1"
  echo "Killing processes that contain '$NAME'"
  docker ps | grep $NAME | awk {'print $1'} | xargs docker kill
}

# GRN
# Function to grep the current directory
# (recursively) for the provided pattern.
# $1 (mandatory) specifies a pattern to find
grn() {
  if [[ -z $1 ]]; then
    echo "Must provide a pattern to find"
    return
  fi

  grep -rn "$1" .
}

# IGNORE
# Function to add patterns to the .gitignore file
# $1 (mandatory) specifies a pattern to ignore
ignore() {
  if [[ -z $1 ]]; then
    echo "Must provide a pattern to ignore"
    return
  fi

  echo "$1" >> .gitignore
}

# KNOWN-HOSTS
# Function to easily perform operations on the current
# users known_hosts file. At present the function supports
# 'find', 'add' and 'show', all of which are idempotent.
# $1 (mandatory) specifies an action to execute {'add', 'find', 'show'}
# $2 (mandatory for 'add' and 'find') a hostname or IP
known-hosts() {
  KNOWN_HOSTS=~/.ssh/known_hosts

  if [ "$1" == "add" ]; then
    # Check parameters
    if [[ -z $2 ]]; then
      echo "Must provide a host or IP to add"
      return
    fi

    # Attempt to retrieve the rsa token from the provided host
    KEY=`ssh-keyscan -t rsa -H $2`
    if [[ -z $KEY ]]; then
      echo "'$2' is not a valid host or is unreachable"
      return
    fi

    # Abort if there is already an entry for the provided host
    FOUND=`ssh-keygen -H -F $2`
    if [[ ! -z $FOUND ]]; then
      echo "There is already an entry for '$2' in $KNOWN_HOSTS"
      return
    fi

    # Add the new entry to known_hosts
    echo $KEY >> $KNOWN_HOSTS
    echo "Added an entry for '$2' in $KNOWN_HOSTS"
  elif [ "$1" == "find" ]; then
    # Check parameters
    if [[ -z $2 ]]; then
      echo "Must provide a host or IP to find"
      return
    fi

    # Attempt to find the provided host in known_hosts
    FOUND=`ssh-keygen -H -F $2`
    if [[ -z $FOUND ]]; then
      echo "An entry for '$2' was not found in $KNOWN_HOSTS"
    else
      echo -e $FOUND
    fi
  elif [ "$1" == "remove" ]; then
    # Check parameters
    if [[ -z $2 ]]; then
      echo "Must provide a host or IP to remove"
      return
    fi

    # Attempt to find the provided host in known_hosts
    FOUND=`ssh-keygen -H -F $2`
    if [[ -z $FOUND ]]; then
      echo "An entry for '$2' was not found in $KNOWN_HOSTS"
      return
    fi

    ssh-keygen -R $2
    echo "Removed '$2' from $KNOWN_HOSTS"
  elif [ "$1" == "show" ]; then
    less $KNOWN_HOSTS
  else
    # Check parameters
    if [[ -z $1 ]]; then
      echo "Must provide an action. Try 'add', 'find' or 'show'"
      return
    fi

    echo "'$1' is not a valid action. Try 'add', 'find' or 'show'"
    return
  fi
}

# LOG
# Function to execute a program and log all output to a file.
# -p (optional) prints the output to the terminal as well
# $1 (mandatory) specifies an executable to run
log() {
  local OPTIND

  PRINT=0

  while getopts "p" OPTION; do
    case "$OPTION" in
      p) PRINT=1;;
      ?) return;;
    esac
  done
  shift $((OPTIND-1))

  if [[ -z $1 ]]; then
    echo "Must provide an executable to run"
    return
  fi
  SCRIPT_PATH=$(readlink -f $1)
  if [[ -z $SCRIPT_PATH || ! -e $SCRIPT_PATH || ! -x $SCRIPT_PATH ]]; then
    echo "Must provide a valid executable"
  else
    LOG_FILE="$(basename ${SCRIPT_PATH%.*}).log.$(date +%Y%m%dT%H%M%S)"
    PRINT_STR=$([ "$PRINT" == 1 ] && echo "| tee" || echo ">")
    eval "$SCRIPT_PATH 2>&1 $PRINT_STR $LOG_FILE"
    echo "'$SCRIPT_PATH' output logged to '$LOG_FILE'"
  fi
}

# NUMF
# Function to count the number of files in a directory.
# -a (optional) includes hidden files in the count
# $1 (optional) specifies a directory, the default is the current directory
numf() {
  local OPTIND

  ALL=0

  while getopts "a" OPTION; do
    case $OPTION in
      a) ALL=1;;
      ?) return;;
    esac
  done
  shift $((OPTIND-1))

  LS_ARGS="."
  SUBTRACT=0
  if [[ ! -z $1 ]]; then
    DIR_PATH=$(readlink -f $1)
    if [[ ! -d $DIR_PATH ]]; then
      echo "'$DIR_PATH' is not a valid directory."
      return;
    fi
    LS_ARGS=$DIR_PATH
  fi
  if [ $ALL -eq 1 ]; then
    LS_ARGS="-a $LS_ARGS"
    # Subtract 2 from the final for . and .. links
    SUBTRACT=2
  fi

  NUM_FILES=`ls $LS_ARGS | wc -l`
  echo "Found $(($NUM_FILES - $SUBTRACT)) file(s)"
}

# PSAG
# Function to grep through ps output.
# -k (optional) kills any matching processes
# $1 (mandatory) a string for which to grep
psag() {
  local OPTIND

  KILL=0

  while getopts "k" OPTION; do
    case "$OPTION" in
      k) KILL=1;;
      ?) return;;
    esac
  done
  shift $((OPTIND-1))

  if [[ -z $1 ]]; then
    echo "Must provide something to grep for"
    return
  fi
  QUERY=$1
  CMD="ps aux | grep -v grep | grep '$QUERY'"
  if [ $KILL -eq 1 ]; then
    CMD="$CMD | awk {'print \$2'} | sudo xargs kill -9"
  fi
  eval "$CMD"
}

# U
# Function to travel up the directory chain.
# $1 (optional) the number of times to go up, defaults to 1
u() {
  N=1
  if [[ ! -z $1 ]]; then
    if [[ $1 =~ ^[0-9]+$ ]]; then
      N=$1
    else
      echo "u only takes numbers as arguments"
      return
    fi
  fi
  while [ $(( N -= 1 )) -ge 0 ]; do
    cd ..
  done
}

# SYNC-DOTS
# Function to sync homebase files from home directory back to repository
# -d (optional) dry run mode - shows what would be synced without making changes
# This function handles both files and directories
sync-dots() {
  local OPTIND
  local DRY_RUN=0

  while getopts "d" OPTION; do
    case "$OPTION" in
      d) DRY_RUN=1;;
      ?) return;;
    esac
  done
  shift $((OPTIND-1))

  # Find the homebase repository by locating its .git directory
  local candidates=()
  while IFS= read -r dir; do
    candidates+=("$dir")
  done < <(find "$HOME" -maxdepth 6 -type d -name "homebase" -exec test -d "{}/.git" \; -print 2>/dev/null)

  if [ "${#candidates[@]}" -eq 0 ]; then
    echo "Homebase repository not found under $HOME"
    return 1
  elif [ "${#candidates[@]}" -gt 1 ]; then
    echo "Multiple homebase repositories found; refusing to guess:"
    printf '  %s\n' "${candidates[@]}"
    return 1
  fi
  # Use head -1 to portably get the first element: zsh arrays are 1-indexed,
  # bash arrays are 0-indexed, so ${candidates[0]} is empty in zsh.
  HOMEBASE_REPO=$(printf '%s\n' "${candidates[@]}" | head -n 1)

  # List of files to sync (both files and directories).
  # Entries in setup.sh's LINKED_CONFIGS array (.claude/local-skills,
  # .claude/CLAUDE.md, .claude/commands, .claude/references, .claude/statusline.sh,
  # bin) are intentionally omitted here: they live as symlinks in $HOME, so
  # edits already land in the repo without syncing.
  SYNC_FILES=(
    ".aliases"
    ".bashrc"
    ".bash_profile"
    ".functions"
    ".gitconfig"
    ".profile"
    ".screenrc"
    ".vimrc"
    ".zshrc"
    ".vscode/settings.json"
    ".vscode/extensions.txt"
    ".claude/plugins"
    ".claude/skills"
    ".claude/settings.json"
  )

  if [ $DRY_RUN -eq 1 ]; then
    echo "DRY RUN: Showing what would be synced..."
    echo
  fi

  # Sync each file/directory
  for item in "${SYNC_FILES[@]}"; do
    SOURCE="$HOME/$item"
    DEST="$HOMEBASE_REPO/$item"

    if [ -e "$SOURCE" ]; then
      if [ $DRY_RUN -eq 1 ]; then
        if [ -d "$SOURCE" ]; then
          if [[ "$item" == ".claude/plugins" ]]; then
            echo "Would sync directory: $item (excluding: .credentials.json, installed_plugins.json, cache/)"
          else
            echo "Would sync directory: $item"
          fi
        else
          echo "Would sync file: $item"
        fi
      else
        if [ -d "$SOURCE" ]; then
          # For directories, use rsync to sync contents
          echo "Syncing directory: $item"
          # Create parent directory if needed for subdirectories like .claude/command
          mkdir -p "$(dirname "$DEST")"
          # Exclude sensitive files from .claude/plugins
          if [[ "$item" == ".claude/plugins" ]]; then
            rsync -av \
              --exclude '.credentials.json' \
              --exclude 'installed_plugins.json' \
              --exclude 'cache/' \
              "$SOURCE/" "$DEST/"
          else
            rsync -av "$SOURCE/" "$DEST/"
          fi
        else
          # For files, use cp
          echo "Syncing file: $item"
          cp "$SOURCE" "$DEST"
        fi
      fi
    else
      echo "Skipping $item (not found in home directory)"
    fi
  done

  if [ $DRY_RUN -eq 0 ]; then
    echo
    echo "Sync complete! Review changes with 'cd $HOMEBASE_REPO && git status'"
  fi
}

# FIND-AND-SOURCE-ENV
# Function to find and source .env.local files
# Walks up the directory tree from PWD looking for .env.local
# Falls back to global ~/.env.local if no local file is found
find_and_source_env() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.env.local" ]]; then
            set -a
            . "$dir/.env.local"
            set +a
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    # Fall back to global .env.local
    if [[ -f ~/.env.local ]]; then
        set -a
        . ~/.env.local
        set +a
        return 0
    fi
    return 1
}

# GWS-PROFILE
# Multi-profile support for the gws (Google Workspace) CLI.
# Layered model:
#   1. Ambient profile from ~/.config/gws-current (persists across shells)
#   2. Directory override via .account markers + chpwd hook (zsh)
#   3. Pin via gws-pin to disable the hook in the current shell
# Per-command override stays available: GOOGLE_WORKSPACE_CLI_CONFIG_DIR=... gws ...
# The .account marker is shared across tools (also read by ~/bin/claude).
__gws_resolve_profile() {
    [[ "${GWS_AUTO_SWITCH:-1}" == "0" ]] && return 0

    # Walk up from PWD looking for the nearest .account marker.
    local dir="$PWD"
    local target=""
    while :; do
        if [[ -f "$dir/.account" ]]; then
            target="$(cat "$dir/.account" 2>/dev/null)"
            target="${target//[$'\t\r\n ']/}"
            break
        fi
        [[ "$dir" == "$HOME" || "$dir" == "/" ]] && break
        dir="$(dirname "$dir")"
    done

    # Fall back to the ambient profile from the state file.
    if [[ -z "$target" ]]; then
        target="$(cat "$HOME/.config/gws-current" 2>/dev/null)"
        target="${target//[$'\t\r\n ']/}"
        [[ -z "$target" ]] && target="home"
    fi

    # Skip re-export when nothing has changed. The dir-existence check makes
    # this self-healing: if a parent shell exported a stale config dir (e.g.,
    # left over from a since-renamed profile), the env survives until the dir
    # is missing on disk, at which point we drop through and re-export against
    # the current resolution.
    if [[ "$target" == "${GWS_PROFILE:-}" && -d "${GOOGLE_WORKSPACE_CLI_CONFIG_DIR:-}" ]]; then
        return 0
    fi

    local target_dir="$HOME/.config/gws-$target"
    if [[ -d "$target_dir" ]]; then
        export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$target_dir"
        export GWS_PROFILE="$target"
    fi
}

# Register chpwd hook (zsh only) and run once at source time.
if [[ -n "${ZSH_VERSION:-}" ]]; then
    autoload -Uz add-zsh-hook 2>/dev/null
    add-zsh-hook chpwd __gws_resolve_profile 2>/dev/null
fi
__gws_resolve_profile

gws-use() {
    if [[ -z "${1:-}" ]]; then
        echo "current: ${GWS_PROFILE:-<none>}${GWS_AUTO_SWITCH:+ (pinned)}"
        echo "available:"
        local d name
        for d in "$HOME"/.config/gws-*/; do
            [[ -d "$d" ]] || continue
            name="${d##*/.config/gws-}"
            name="${name%/}"
            echo "  $name"
        done
        return 0
    fi
    local profile="$1"
    local dir="$HOME/.config/gws-$profile"
    if [[ ! -d "$dir" ]]; then
        echo "gws profile not found: $profile (expected $dir)" >&2
        return 1
    fi
    printf '%s\n' "$profile" > "$HOME/.config/gws-current"
    unset GWS_AUTO_SWITCH
    export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$dir"
    export GWS_PROFILE="$profile"
    echo "gws ambient profile -> $profile"
}

gws-pin() {
    export GWS_AUTO_SWITCH=0
    echo "gws auto-switch disabled (locked to ${GWS_PROFILE:-<none>})"
}

gws-unpin() {
    unset GWS_AUTO_SWITCH
    __gws_resolve_profile
    echo "gws auto-switch enabled (now: ${GWS_PROFILE:-<none>})"
}

gws-whoami() {
    echo "profile: ${GWS_PROFILE:-<none>}${GWS_AUTO_SWITCH:+ (pinned)}"
    echo "config:  ${GOOGLE_WORKSPACE_CLI_CONFIG_DIR:-<none>}"
    command gws auth status 2>/dev/null || echo "(not authenticated)"
}
