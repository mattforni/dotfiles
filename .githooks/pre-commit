#!/usr/bin/env bash
# Lint staged markdown and shell before a commit lands.
#
# Tracked in the repo rather than dropped in .git/hooks so it survives a fresh
# clone. Activate once per clone with:
#
#   git config core.hooksPath .githooks
#
# The setting is repo level, so it covers every worktree cut from that clone.
# `git commit --no-verify` bypasses it when something genuinely has to land
# unlinted. It never blocks on missing tooling: no npx, or a linter that cannot
# run, warns and lets the commit through.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 0
YELLOW=$'\033[1;33m'; RED=$'\033[0;31m'; NC=$'\033[0m'
status=0

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# Markdown
md=()
for f in "${staged[@]}"; do
  case "$f" in
    *.md|*.markdown) [[ -f "$ROOT/$f" ]] && md+=("$f") ;;
  esac
done

if [[ ${#md[@]} -gt 0 ]]; then
  if command -v npx &>/dev/null; then
    if ! (cd "$ROOT" && npx --yes markdownlint-cli2 "${md[@]}"); then
      printf "${RED}[x]${NC} markdown lint failed. Fix, or re-run with --no-verify.\n" >&2
      printf "    Most of it clears with: npx markdownlint-cli2 --fix %s\n" "${md[*]}" >&2
      status=1
    fi
  else
    printf "${YELLOW}[!]${NC} npx not found, skipping markdown lint\n"
  fi
fi

# Shell
sh=()
for f in "${staged[@]}"; do
  [[ -f "$ROOT/$f" ]] && sh+=("$f")
done

if [[ ${#sh[@]} -gt 0 ]] && [[ -x "$ROOT/bin/lint/shell" ]]; then
  if ! "$ROOT/bin/lint/shell" "${sh[@]}"; then
    printf "${RED}[x]${NC} shell lint failed. Fix, or re-run with --no-verify.\n" >&2
    status=1
  fi
fi

# Runners, only when a plist or the library stating their PATH is staged. The
# check is whole repo rather than per file, because the failure it catches is a
# disagreement between two files and staging either one can create it.
runners=()
for f in "${staged[@]}"; do
  case "$f" in
    launchagents/*.plist|bin/runner/lib.sh|runners/*) runners+=("$f") ;;
  esac
done

if [[ ${#runners[@]} -gt 0 ]] && [[ -x "$ROOT/bin/lint/runners" ]]; then
  if ! "$ROOT/bin/lint/runners"; then
    printf "${RED}[x]${NC} runner checks failed. Fix, or re-run with --no-verify.\n" >&2
    status=1
  fi
fi

# Context size ratchet, only when an always loaded file is staged
ctx=()
for f in "${staged[@]}"; do
  case "$f" in
    CLAUDE.md|.claude/CLAUDE.md) ctx+=("$f") ;;
  esac
done

if [[ ${#ctx[@]} -gt 0 ]] && [[ -x "$ROOT/bin/lint/context-size" ]]; then
  if ! "$ROOT/bin/lint/context-size" "${ctx[@]}"; then
    printf "${RED}[x]${NC} context size cap exceeded. Move depth into .claude/rules/ or a tool doc, or re-run with --no-verify.\n" >&2
    status=1
  fi
fi

exit $status
