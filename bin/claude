#!/usr/bin/env bash
# Per-profile wrapper around the real `claude` binary.
#
# Walks up from $PWD finding the nearest .account marker (shared with the gws
# resolver in .functions). Falls back to the ambient profile in
# ~/.config/gws-current. Sets CLAUDE_CONFIG_DIR for the matching profile and
# exec's the real binary.
#
# Auth note: Claude Code stores OAuth tokens per CLAUDE_CONFIG_DIR natively
# (in a `Claude Code-credentials-<hash>` Keychain entry where the hash is
# derived from the config dir path). Setting CLAUDE_CONFIG_DIR is enough to
# pick the right account; no token injection needed.
#
# Profile dirs like ~/.claude-home/ are populated by
# bin/claude-profiles-init.sh (invoked from setup.sh). The first time you
# launch into a freshly-bootstrapped profile dir, Claude Code triggers an
# OAuth browser flow and stores the resulting credential under the hashed
# Keychain entry for that dir.

set -euo pipefail

# Marker parsing and profile resolution are shared with ~/bin/gws and
# .functions. $0 is the invoked path, so this resolves through the ~/bin symlink
# as well as the real repo path.
#
# A missing library must never stop Claude Code from launching, so this degrades
# to the home profile with a warning rather than exiting. That is the profile a
# machine with no marker at all would land on anyway.
ACCOUNT_LOG_PREFIX="claude wrapper"
account_lib="$(dirname "$0")/lib/account-profile.sh"
if [[ -r "$account_lib" ]]; then
    # shellcheck source-path=SCRIPTDIR
    # shellcheck source=lib/account-profile.sh
    . "$account_lib"
    profile="$(account_resolve_profile)"
else
    echo "claude wrapper: cannot read $account_lib, defaulting to the home profile" >&2
    profile="home"
fi
cfg_dir="$HOME/.claude-$profile"

# Find the next `claude` on PATH that isn't this wrapper.
# Bash's `-ef` test compares files by device+inode, so it correctly handles
# the case where this script is reached via a symlink in PATH (e.g.
# ~/bin/claude -> .../homebase/bin/claude) and the same physical file appears
# under a different PATH entry.
real_claude=""
IFS=':' read -ra path_parts <<< "$PATH"
for p in "${path_parts[@]}"; do
    candidate="$p/claude"
    if [[ -x "$candidate" && ! "$candidate" -ef "$0" ]]; then
        real_claude="$candidate"
        break
    fi
done
if [[ -z "$real_claude" ]]; then
    echo "claude wrapper: cannot find real claude binary on PATH" >&2
    exit 127
fi

# Inject the YNAB personal access token from the login Keychain so the `ynab`
# MCP server (registered in .claude.json with a ${YNAB_ACCESS_TOKEN}
# placeholder) resolves to a real value at launch. The token is kept out of the
# JSON on disk; the canonical copy lives in BitWarden, seeded into Keychain by
# setup.sh. A missing entry leaves the var unset, so non-YNAB sessions are
# untouched. ${arr[@]+...} guards the empty-array case under bash 3.2 + set -u.
ynab_env=()
ynab_token="$(security find-generic-password -a "$USER" -s ynab-token -w 2>/dev/null || true)"
[[ -n "$ynab_token" ]] && ynab_env+=("YNAB_ACCESS_TOKEN=$ynab_token")

# Fall back to default config root if the profile dir does not exist.
if [[ ! -d "$cfg_dir" ]]; then
    echo "claude wrapper: $cfg_dir not found, using default config" >&2
    exec env ${ynab_env[@]+"${ynab_env[@]}"} "$real_claude" "$@"
fi

exec env CLAUDE_CONFIG_DIR="$cfg_dir" ${ynab_env[@]+"${ynab_env[@]}"} "$real_claude" "$@"
