#!/usr/bin/env bash
# Per-profile PATH shim around the real `gws` binary.
#
# Walks up from $PWD finding the nearest .account marker (the same marker read
# by ~/bin/claude and by __gws_resolve_profile in .functions), then exports
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR for the matching profile and exec's the real
# binary. `gws` itself has no --config-dir flag, so the environment variable is
# the only lever.
#
# Why a shim and not just the shell hook: .functions resolves the profile at
# source time and on the zsh chpwd hook. Neither fires in an agent shell.
# Claude Code captures a shell snapshot once per session and replays it for
# every tool call; the snapshot preserves function definitions but drops
# top-level calls, so the source time resolution is lost. chpwd never fires
# either, because the shell starts already sitting in the target directory
# rather than changing into it. The net effect was that every agent shell
# inherited whatever profile the launching terminal happened to have, and a
# .account marker one directory away was never read. The same hole exists for
# launchd jobs, cron, CI, and any `sh -c` caller.
#
# Resolving here, at invocation time, is the one layer that holds for every
# caller regardless of how the process was started.
#
# Precedence, highest first:
#   1. gws-pin (GWS_AUTO_SWITCH=0): the caller locked a profile deliberately.
#   2. One shot override: GOOGLE_WORKSPACE_CLI_CONFIG_DIR set to something other
#      than the value a resolver last stamped into GWS_RESOLVED_DIR.
#   3. Nearest .account marker walking up from $PWD.
#   4. Ambient profile from ~/.config/gws-current.

set -euo pipefail

# Marker parsing and profile resolution are shared with ~/bin/claude and
# .functions. $0 is the invoked path, so this resolves through the ~/bin symlink
# as well as the real repo path.
ACCOUNT_LOG_PREFIX="gws shim"
account_lib="$(dirname "$0")/lib/account-profile.sh"
if [[ -r "$account_lib" ]]; then
    # shellcheck source=lib/account-profile.sh
    . "$account_lib"
else
    account_lib_missing=1
    echo "gws shim: cannot read $account_lib, leaving config untouched" >&2
fi

# Find the next `gws` on PATH that isn't this shim.
# Bash's `-ef` test compares files by device+inode, so it correctly handles
# this script being reached via a symlink in PATH (~/bin -> homebase/bin).
# The -d guard matters because a directory is also -x, and bin/ holds tool
# namespace folders alongside shims.
real_gws=""
IFS=':' read -ra path_parts <<< "$PATH"
for p in "${path_parts[@]}"; do
    candidate="$p/gws"
    if [[ -x "$candidate" && ! -d "$candidate" && ! "$candidate" -ef "$0" ]]; then
        real_gws="$candidate"
        break
    fi
done
if [[ -z "$real_gws" ]]; then
    echo "gws shim: cannot find real gws binary on PATH" >&2
    exit 127
fi

# 1. gws-pin locks the profile for the current shell. Respect it.
if [[ "${GWS_AUTO_SWITCH:-1}" == "0" ]]; then
    exec "$real_gws" "$@"
fi

# 2. Deliberate one shot override, keeping the documented
#    `GOOGLE_WORKSPACE_CLI_CONFIG_DIR=... gws ...` form working.
#
#    Every resolver stamps GWS_RESOLVED_DIR with the config dir it set, so a
#    config dir that still matches the stamp was inherited and is safe to
#    re-resolve, while one that differs was set by the caller on purpose.
#
#    The stamp must be PRESENT for this to count as an override. A shell that
#    never ran a resolver has no stamp, and that is precisely the situation this
#    shim exists to correct, so an unstamped config dir is treated as inherited
#    rather than intentional. Callers in stamp free contexts (launchd, cron, raw
#    sh -c) that genuinely need to force an account use GWS_AUTO_SWITCH=0 above.
if [[ -n "${GWS_RESOLVED_DIR:-}" \
   && -n "${GOOGLE_WORKSPACE_CLI_CONFIG_DIR:-}" \
   && "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR" != "$GWS_RESOLVED_DIR" ]]; then
    exec "$real_gws" "$@"
fi

# A broken install cannot resolve anything. Pass through rather than guessing at
# an account, since guessing wrong is the failure this shim exists to prevent.
if [[ -n "${account_lib_missing:-}" ]]; then
    exec "$real_gws" "$@"
fi

# 3 and 4. Marker first, ambient second.
profile="$(account_resolve_profile)"
cfg_dir="$HOME/.config/gws-$profile"

# A marker can name a profile that has no config dir yet (a fresh machine, or a
# profile retired without the marker being cleaned up). Fall back to the ambient
# profile rather than letting gws quietly pick its own default, which is how a
# non interactive caller ends up on the wrong account with no signal.
if [[ ! -d "$cfg_dir" ]]; then
    fallback="$(account_ambient_profile)"
    if [[ "$fallback" != "$profile" && -d "$HOME/.config/gws-$fallback" ]]; then
        echo "gws shim: profile '$profile' has no config dir, falling back to ambient '$fallback'" >&2
        profile="$fallback"
        cfg_dir="$HOME/.config/gws-$profile"
    else
        echo "gws shim: no usable config dir for profile '$profile', leaving config untouched" >&2
        exec "$real_gws" "$@"
    fi
fi

exec env \
    GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$cfg_dir" \
    GWS_RESOLVED_DIR="$cfg_dir" \
    GWS_PROFILE="$profile" \
    "$real_gws" "$@"
