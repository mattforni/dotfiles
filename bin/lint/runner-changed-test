#!/usr/bin/env bash
# Table test for bin/runner/changed, the script that decides which runner
# images a merge to main promotes.
#
# A wrong answer here is silent in both directions: a path that should promote
# and does not leaves a scheduled job on an old image with a green run beside
# it, and one that promotes when nothing shipped spends a Cloud Build for
# nothing. So this builds a throwaway repository with a small invented
# runners/ tree, commits one change at a time, and holds the printed list
# against what each rule says.
#
# Checks: the shared library and the renderer reach every runner, the two
# scripts that decide what ships do too, a runner's own files reach only it,
# a runner's page reaches only it, the paths that never ship reach nothing,
# an agent reaches the runners whose manifest names it, a path a context
# manifest or an agent line names reaches the runner that named it, a runner
# without a Dockerfile is never printed, an unusable base means everything,
# and --all.
set -uo pipefail

# Under the pre-commit hook git exports where its index and directory are, and
# every git call below would then land on the real repository's index instead
# of the throwaway one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

REPO=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "not in a git repo"; exit 1; }
CHANGED="$REPO/bin/runner/changed"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAKE="$WORK/repo"

pass=0; fail=0
ok()   { printf '  \033[0;32mok\033[0m   %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[0;31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }

g() { git -C "$FAKE" -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false "$@"; }

# Usage: put <path> [content]. Writes a file in the fake repository.
put() {
  mkdir -p "$FAKE/$(dirname "$1")"
  printf '%s\n' "${2:-$RANDOM$RANDOM}" > "$FAKE/$1"
}

# Usage: commit. Commits everything and prints the new commit.
commit() {
  g add -A >/dev/null && g commit --quiet --no-verify --allow-empty -m change >/dev/null || return 1
  g rev-parse HEAD
}

# Usage: expect <label> <want, space separated> <base> <head>
expect() {
  local label="$1" want="$2" got
  shift 2
  if ! got="$("$CHANGED" -C "$FAKE" "$@" 2>"$WORK/err")"; then
    bad "$label (exited non zero: $(cat "$WORK/err"))"
    return
  fi
  got="$(printf '%s' "$got" | tr '\n' ' ' | sed 's/ $//')"
  if [[ "$got" == "$want" ]]; then ok "$label"; else bad "$label (wanted '$want', got '$got')"; fi
}

# Usage: change <label> <want> <path>... Touches each path, commits, and
# holds the diff from the commit before against the list.
change() {
  local label="$1" want="$2" before after p
  shift 2
  before="$(g rev-parse HEAD)"
  for p in "$@"; do put "$p"; done
  after="$(commit)" || { bad "$label (could not commit)"; return; }
  expect "$label" "$want" "$before" "$after"
}

# --- the invented tree --------------------------------------------------------
# Three runners with a Dockerfile and one without. alpha and beta each name an
# agent, gamma names none, and beta's manifest carries a comment and a blank
# line the way a real one may.
git init --quiet "$FAKE" || exit 1
for r in alpha beta gamma; do
  put "runners/$r/Dockerfile"
  put "runners/$r/entrypoint.sh"
  put "runners/$r/prompt.md"
  put "runners/$r/README.md"
done
# Three names with alpha first and no newline after the last: a match on the
# first name must not depend on what follows it, and the last name is one a
# bare `while read` would drop.
printf 'alpha\nextra\nthird' > "$FAKE/runners/alpha/agents"
put .claude/agents/extra.md
put .claude/agents/third.md
# `shared` is indented with a trailing space: the staging reads the manifest
# with `read`, which trims both, so that line ships the agent and has to match.
printf '# what beta runs\n\nbeta\n  shared \n' > "$FAKE/runners/beta/agents"
put runners/alpha/mounts
put runners/localonly/entrypoint.sh
put runners/localonly/prompt.md
put runners/lib/runner.sh
put runners/email/render.tsx
put runners/email/package.json
put runners/email/package-lock.json
put runners/email/build.mjs
put runners/email/jq.ts
put runners/email/local.tsx
put runners/email/alpha.tsx
put runners/email/beta.tsx
put runners/email/localonly.tsx
put runners/email/tst/render.test.mjs
put runners/email/fixtures/alpha.json
put runners/email/goldens/alpha.html
put runners/tst/lib.test.mjs
put runners/README.md
put .claude/agents/alpha.md
put .claude/agents/beta.md
put .claude/agents/shared.md
put .claude/agents/unlisted.md
put bin/runner/promote
put bin/runner/lib.sh
put bin/runner/changed
put bin/runner/fire
put README.md
ROOT_COMMIT="$(commit)" || { echo "could not build the fake repository"; exit 1; }

echo "Shared paths reach every runner"
change "runners/lib reaches every runner"        "alpha beta gamma" runners/lib/runner.sh
change "a new file in runners/lib does too"      "alpha beta gamma" runners/lib/pull.mjs
# A script that leaves the shared library (the funnel rules moved to the
# Atelic repo, which the runs clone) has to leave every image too.
before="$(g rev-parse HEAD)"
g rm --quiet runners/lib/pull.mjs
after="$(commit)"
expect "a file leaving runners/lib reaches every runner" "alpha beta gamma" "$before" "$after"
change "runners/email reaches every runner"      "alpha beta gamma" runners/email/render.tsx
change "the renderer's package file does too"    "alpha beta gamma" runners/email/package.json
change "and its lockfile"                        "alpha beta gamma" runners/email/package-lock.json
change "and the script that builds a bundle"     "alpha beta gamma" runners/email/build.mjs
change "a helper any page may import"            "alpha beta gamma" runners/email/jq.ts
# Shaped like a page, named for no runner: a component file every page shares.
change "a tsx that is no runner's page"          "alpha beta gamma" runners/email/local.tsx
change "a tsx in a folder under the renderer"    "alpha beta gamma" runners/email/parts/alpha.tsx
change "bin/runner/promote reaches every runner" "alpha beta gamma" bin/runner/promote
change "bin/runner/lib.sh reaches every runner"  "alpha beta gamma" bin/runner/lib.sh

echo "A runner's own files reach only that runner"
change "an entrypoint reaches its runner"        "beta"       runners/beta/entrypoint.sh
change "a Dockerfile reaches its runner"         "gamma"      runners/gamma/Dockerfile
change "a new file reaches its runner"           "alpha"      runners/alpha/listings.jq
change "two runners in one diff, sorted"         "alpha gamma" runners/gamma/prompt.md runners/alpha/prompt.md
change "a nested README still ships"             "beta"       runners/beta/docs/README.md
# git quotes and escapes a name like this one unless asked not to, and a
# quoted path would match no rule.
change "a name past ASCII reaches its runner"    "gamma"      "runners/gamma/café.jq"
change "a name with a space reaches its runner"  "beta"       "runners/beta/two words.jq"

echo "A runner's page reaches only that runner"
# A bundle is built around one page, so the retro's page is in the retro's
# image and no other. Promoting every runner for it would be three builds
# where one image changed.
change "a page reaches the runner it is named for" "alpha"     runners/email/alpha.tsx
change "two pages reach their two runners"       "alpha beta"  runners/email/beta.tsx runners/email/alpha.tsx
change "a page beside a shared file reaches all" "alpha beta gamma" runners/email/alpha.tsx runners/email/render.tsx
change "the page of a runner with no Dockerfile" ""            runners/email/localonly.tsx
change "a page a runner keeps in its own folder" "gamma"       runners/gamma/email/gamma.tsx
change "and the helper it keeps beside it"       "gamma"       runners/gamma/email/gamma-rows.tsx
# A runner that leaves takes its page with it, and no other image held it.
put runners/delta/Dockerfile
put runners/delta/entrypoint.sh
put runners/email/delta.tsx
commit >/dev/null
before="$(g rev-parse HEAD)"
g rm --quiet -r runners/delta runners/email/delta.tsx
after="$(commit)"
expect "a runner and its page leaving reach no other runner" "" "$before" "$after"
# A runner that moves to another repository leaves with everything that was
# its alone: its directory, its page, the page's fixtures and goldens, and the
# agent only its manifest named. None of that is in any image still built
# here, and the runner itself must never be printed: a promote of a directory
# that is gone fails red.
put runners/delta/Dockerfile
put runners/delta/entrypoint.sh
printf 'delta\n' > "$FAKE/runners/delta/agents"
put .claude/agents/delta.md
put runners/email/delta.tsx
put runners/email/fixtures/delta.json
put runners/email/goldens/delta.html
commit >/dev/null
before="$(g rev-parse HEAD)"
g rm --quiet -r runners/delta runners/email/delta.tsx runners/email/fixtures/delta.json runners/email/goldens/delta.html .claude/agents/delta.md
after="$(commit)"
expect "a runner leaving with its page, fixtures and agent promotes nothing" "" "$before" "$after"
# The same leaving, with a pull only it used going out of the shared library
# too: every image that is still here changed, and the one that left is not
# among them.
put runners/delta/Dockerfile
put runners/delta/entrypoint.sh
put runners/lib/delta-pull.mjs
commit >/dev/null
before="$(g rev-parse HEAD)"
g rm --quiet -r runners/delta runners/lib/delta-pull.mjs
after="$(commit)"
expect "and with a shared library file, only the runners that stay" "alpha beta gamma" "$before" "$after"

echo "Paths that never ship reach nothing"
change "a runner's README"                       "" runners/alpha/README.md
change "a runner's mounts"                       "" runners/alpha/mounts
change "a runner's out, .build and .env.local"   "" runners/alpha/out/email.html runners/alpha/.build/Dockerfile runners/alpha/.env.local
change "a name past ASCII under out"             "" "runners/alpha/out/café.html"
change "the renderer's tests"                    "" runners/email/tst/render.test.mjs
change "the renderer's fixtures and goldens"     "" runners/email/fixtures/alpha.json runners/email/goldens/alpha.html
change "a runner's own page tests and goldens"   "" runners/gamma/email/tst/gamma.test.mjs runners/gamma/email/tst/goldens/gamma.html
change "the library's tests in runners/tst"      "" runners/tst/lib.test.mjs
change "runners/README.md"                       "" runners/README.md
change "a runner with no Dockerfile"             "" runners/localonly/entrypoint.sh
change "this script and its neighbours"          "" bin/runner/changed bin/runner/fire
change "a file nowhere near a runner"            "" README.md

echo "A never ships path does not hide one that ships"
change "README beside an entrypoint"             "alpha" runners/alpha/README.md runners/alpha/entrypoint.sh
change "README in one runner, prompt in another" "beta"  runners/alpha/README.md runners/beta/prompt.md

echo "Agents follow the manifests"
change "the first agent of several in a manifest" "alpha" .claude/agents/alpha.md
change "the last, with no newline after it"      "alpha" .claude/agents/third.md
change "an agent on an indented manifest line"   "beta"  .claude/agents/shared.md
change "an agent no manifest names"              ""      .claude/agents/unlisted.md
change "a file under agents that is no agent"    ""      .claude/agents/notes/alpha.md
# The manifest never reaches the staged context itself, but it decides which
# agents do, so a change to it is a change to the image.
put runners/gamma/agents "shared"
before="$(g rev-parse HEAD)"
after="$(commit)"
expect "a new manifest reaches its runner" "gamma" "$before" "$after"
change "the manifest is read at head"            "beta gamma" .claude/agents/shared.md

echo "Manifests reach outside the runner's directory"
# A context manifest adds files from elsewhere in the repository to a staged
# context, so a change to one of them is a change to that runner's image and
# to no other. The manifest never ships itself, and like `agents` it decides
# what does.
put shared/rules/fold.mjs
put shared/rules/deep/sweep.mjs
put shared/other/unrelated.mjs
put shared/one.mjs
commit >/dev/null
printf '# what gamma adds\n\n../../shared/rules:lib/rules\n  ../../shared/one.mjs:one.mjs \n' > "$FAKE/runners/gamma/context"
before="$(g rev-parse HEAD)"
after="$(commit)"
expect "a new context manifest reaches its runner" "gamma" "$before" "$after"
change "a file under a context source"           "gamma" shared/rules/fold.mjs
change "a file deep under a context source"      "gamma" shared/rules/deep/sweep.mjs
change "a new file under a context source"       "gamma" shared/rules/new.mjs
change "a context source that is one file"       "gamma" shared/one.mjs
change "a file beside a context source"          ""      shared/other/unrelated.mjs
change "a file whose name a source only begins"  ""      shared/rules-old/fold.mjs
change "a context source and another runner"     "alpha gamma" shared/rules/fold.mjs runners/alpha/prompt.md
# A line that climbs out of the repository is the staging's to refuse. Here it
# has to be dropped without taking the other lines down with it.
printf '../../../elsewhere:x\n../../shared/rules:lib/rules\n' > "$FAKE/runners/gamma/context"
commit >/dev/null
change "a source past a line that climbs out"    "gamma" shared/rules/fold.mjs
# An agent a runner brings by path is that file and not the one of the same
# name in .claude/agents.
put .claude/agents/own.md
put definitions/own.md
commit >/dev/null
printf '# what beta runs\n\nbeta\n  shared \nown=../../definitions/own.md\n' > "$FAKE/runners/beta/agents"
before="$(g rev-parse HEAD)"
after="$(commit)"
expect "an agent line by path reaches its runner" "beta" "$before" "$after"
change "an agent brought by path"                "beta" definitions/own.md
change "the same name in .claude/agents"         ""     .claude/agents/own.md
change "a bare name beside a path line still matches" "beta" .claude/agents/beta.md

echo "Deletes, renames and new runners"
before="$(g rev-parse HEAD)"
g mv runners/alpha/listings.jq runners/beta/listings.jq
after="$(commit)"
expect "a file moved between runners reaches both" "alpha beta" "$before" "$after"
before="$after"
g rm --quiet runners/gamma/prompt.md
after="$(commit)"
expect "a deleted file reaches its runner" "gamma" "$before" "$after"
before="$after"
put runners/localonly/Dockerfile
after="$(commit)"
expect "a runner gaining a Dockerfile is discovered" "localonly" "$before" "$after"
before="$after"
g rm --quiet runners/localonly/Dockerfile
after="$(commit)"
expect "a runner losing its Dockerfile is not printed" "" "$before" "$after"

echo "An unusable base means every runner"
HEAD_COMMIT="$(g rev-parse HEAD)"
expect "an all zero base"       "alpha beta gamma" 0000000000000000000000000000000000000000 "$HEAD_COMMIT"
expect "an empty base"          "alpha beta gamma" "" "$HEAD_COMMIT"
expect "a base this clone lacks" "alpha beta gamma" 1234567890abcdef1234567890abcdef12345678 "$HEAD_COMMIT"
expect "--all"                  "alpha beta gamma" --all
expect "--all at a named commit" "alpha beta gamma" --all "$ROOT_COMMIT"

echo "Edges"
expect "a base equal to the head prints nothing" "" "$HEAD_COMMIT" "$HEAD_COMMIT"
expect "a span of many commits is one diff" "alpha beta gamma" "$ROOT_COMMIT" "$HEAD_COMMIT"
if "$CHANGED" -C "$FAKE" "$ROOT_COMMIT" not-a-commit >/dev/null 2>&1; then
  bad "an unresolvable head is refused"
else
  ok "an unresolvable head is refused"
fi
if "$CHANGED" -C "$FAKE" "$ROOT_COMMIT" >/dev/null 2>&1; then
  bad "a missing head is refused"
else
  ok "a missing head is refused"
fi

# The real tree, so a rename of runners/ or of the Dockerfile convention that
# empties the list fails here and not as a promote that quietly does nothing.
real="$("$CHANGED" --all 2>/dev/null | tr '\n' ' ')"
if [[ -n "$real" ]]; then ok "the real tree lists at least one runner ($real)"; else bad "the real tree lists no runner"; fi

echo
printf 'pass %d, fail %d\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
