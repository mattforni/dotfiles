#!/usr/bin/env bash
# Test for the two pieces of runners/lib/runner.sh a run's output hangs on
# and that only ever fail on a morning nobody is watching:
#
#   runner_land_file   lands one file on a remote's main from a shallow clone
#                      that main has moved past (the plumber's roster)
#   runner_each_line   runs a function once per line, whatever quotes the
#                      line carries (the plumber's site pull)
#
# The first is driven against a throwaway bare repository that moves between
# the clone and the push, the way main moves during a twenty minute run: a
# second clone, the desk, pushes commits of its own, to files the run never
# touched and to files it did. The old retry fetched one commit deep and
# rebased, and a rebase across a shallow boundary reports add/add conflicts
# on files the commit never touched, so the roster rode the mail as an
# attachment (2026-10-07). A fake git on PATH makes main move again in the
# moment between a fetch and its push, which is the race the retries are for.
#
# Checks: an unmoved main, a main that moved, a main that moved on the very
# file, a main that moves under the first pushes, a main that never stops
# moving, a remote that refuses the push, a file main already holds, and the
# line reader over names with apostrophes, quotes and spaces.
set -uo pipefail

# Under the pre-commit hook git exports where its index and directory are, and
# every git call below would then land on the real repository's index instead
# of the throwaway ones.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRATCH=$(mktemp -d)
trap 'rm -rf "$SCRATCH"' EXIT

# shellcheck source=../../runners/lib/runner.sh
. "$ROOT/runners/lib/runner.sh"

pass=0; fail=0
ok()   { printf '  \033[0;32mok\033[0m   %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[0;31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }

REAL_GIT="$(command -v git)"
ORIGIN="$SCRATCH/origin.git"
DESK="$SCRATCH/desk"
RUN="$SCRATCH/run"
ROSTER="$SCRATCH/built-roster.md"
DEST="Outreach/2026-W01-roster.md"
# The function writes git's stderr under the run's work directory.
WORK="$SCRATCH/work"
mkdir -p "$WORK"
# No pause between tries: nothing here needs the wait a real remote does.
export RUNNER_LAND_PAUSE=0

g() { "$REAL_GIT" -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false "$@"; }

# Usage: desk_push <message> <path> <content> [<path> <content>...]
# The desk writes files and pushes them to main, as another session would.
desk_push() {
    local message="$1"; shift
    g -C "$DESK" pull --quiet origin main >/dev/null 2>&1 || return 1
    while (( $# )); do
        mkdir -p "$DESK/$(dirname "$1")"
        printf '%s\n' "$2" > "$DESK/$1"
        shift 2
    done
    g -C "$DESK" add -A && g -C "$DESK" commit --quiet --no-verify -m "$message" && g -C "$DESK" push --quiet origin HEAD:main
}

# Usage: fresh. A new origin with a little history, a desk clone of it, and
# the run's own clone, one commit deep, as the runner makes it.
fresh() {
    rm -rf "$ORIGIN" "$DESK" "$RUN" "$SCRATCH/moves"
    g init --quiet --bare --initial-branch=main "$ORIGIN" || return 1
    g clone --quiet "$ORIGIN" "$DESK" 2>/dev/null || return 1
    g -C "$DESK" checkout --quiet -B main
    mkdir -p "$DESK/Outreach" "$DESK/plugins/skill"
    printf 'The motion.\n' > "$DESK/Outreach/README.md"
    printf '# The skeleton\n\n## Placed Ahead\n' > "$DESK/$DEST"
    printf 'An older roster.\n' > "$DESK/Outreach/2025-W52-roster.md"
    printf 'A skill.\n' > "$DESK/plugins/skill/SKILL.md"
    g -C "$DESK" add -A && g -C "$DESK" commit --quiet --no-verify -m "the repo" && g -C "$DESK" push --quiet origin HEAD:main || return 1
    desk_push "a second commit" plugins/skill/SKILL.md "A skill, edited." || return 1
    g clone --quiet --depth 1 "file://$ORIGIN" "$RUN" || return 1
    printf '# The W01 roster\n\nBuilt by the run.\n' > "$ROSTER"
}

# What main holds at a path, and how many files main's tip commit changed.
on_main() { g -C "$ORIGIN" show "main:$1" 2>/dev/null; }
tip_files() { g -C "$ORIGIN" show --format= --name-only main | sed '/^$/d' | wc -l | tr -d ' '; }

land() { runner_land_file "$RUN" "$ROSTER" "$DEST" "" "the W01 roster" "built by the test" > "$SCRATCH/land.out" 2>&1; }

echo "A main that has not moved"
if fresh && land; then ok "the file lands"; else bad "the file lands ($(tr '\n' ' ' < "$SCRATCH/land.out"))"; fi
[[ "$(on_main "$DEST")" == "$(cat "$ROSTER")" ]] && ok "main holds the built roster" || bad "main holds the built roster"
[[ "$(tip_files)" == "1" ]] && ok "the commit touches one file" || bad "the commit touches one file ($(tip_files))"
[[ -n "$LANDED_COMMIT" && "$LANDED_COMMIT" == "$(g -C "$ORIGIN" log -1 --format=%h main)" ]] && ok "LANDED_COMMIT names the commit on main" || bad "LANDED_COMMIT names the commit on main ('$LANDED_COMMIT')"

echo "A main that moved between the clone and the push"
fresh || bad "could not build the repositories"
# Other sessions land work while the run is going: an edit to a file the
# clone holds, an edit to an older roster, and a new file.
desk_push "a skill edit" plugins/skill/SKILL.md "A skill, edited again." \
    && desk_push "an older roster and a new file" Outreach/2025-W52-roster.md "An older roster, amended." plugins/skill/routine.md "A new file." \
    || bad "the desk could not push"
desk_tip="$(g -C "$ORIGIN" rev-parse main)"
if land; then ok "the file lands with no rebase"; else bad "the file lands with no rebase ($(tr '\n' ' ' < "$SCRATCH/land.out"))"; fi
[[ "$(on_main "$DEST")" == "$(cat "$ROSTER")" ]] && ok "main holds the built roster" || bad "main holds the built roster"
[[ "$(g -C "$ORIGIN" rev-parse main^ 2>/dev/null)" == "$desk_tip" ]] && ok "the commit sits on the desk's tip" || bad "the commit sits on the desk's tip"
[[ "$(on_main plugins/skill/SKILL.md)" == "A skill, edited again." && "$(on_main plugins/skill/routine.md)" == "A new file." ]] \
    && ok "the desk's work is all still there" || bad "the desk's work is all still there"
[[ "$(tip_files)" == "1" ]] && ok "the commit touches one file" || bad "the commit touches one file ($(tip_files))"

echo "A main that moved on the roster's own path"
fresh || bad "could not build the repositories"
desk_push "a name placed ahead" "$DEST" "# The skeleton, with a name placed ahead" || bad "the desk could not push"
if land; then ok "the file lands"; else bad "the file lands ($(tr '\n' ' ' < "$SCRATCH/land.out"))"; fi
[[ "$(on_main "$DEST")" == "$(cat "$ROSTER")" ]] && ok "the run's roster is what main holds" || bad "the run's roster is what main holds"

echo "A file main already holds"
if land; then ok "a second landing of the same file succeeds"; else bad "a second landing of the same file succeeds"; fi
grep -q "nothing to commit" "$SCRATCH/land.out" && ok "and commits nothing" || bad "and commits nothing ($(tr '\n' ' ' < "$SCRATCH/land.out"))"

# A git that lets the desk push one more commit just before each of the
# run's first pushes, as many times as the file $SCRATCH/moves says: main
# moving in the moment between the run's fetch and its push.
mkdir -p "$SCRATCH/bin"
cat > "$SCRATCH/bin/git" <<FAKE
#!/usr/bin/env bash
left=\$(cat "$SCRATCH/moves" 2>/dev/null || echo 0)
case " \$* " in
  *" push "*)
    if [[ " \$* " == *" $RUN "* ]] && (( left > 0 )); then
        echo \$((left - 1)) > "$SCRATCH/moves"
        "$REAL_GIT" -C "$DESK" pull --quiet origin main >/dev/null 2>&1
        echo "moved \$left" > "$DESK/moved.txt"
        "$REAL_GIT" -C "$DESK" add -A
        "$REAL_GIT" -C "$DESK" -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false commit --quiet --no-verify -m "main moves again"
        "$REAL_GIT" -C "$DESK" push --quiet origin HEAD:main
    fi ;;
esac
exec "$REAL_GIT" "\$@"
FAKE
chmod +x "$SCRATCH/bin/git"
raced() { ( PATH="$SCRATCH/bin:$PATH"; land ); }

echo "A main that moves under the first two pushes"
fresh || bad "could not build the repositories"
echo 2 > "$SCRATCH/moves"
if raced; then ok "the third try lands"; else bad "the third try lands ($(tr '\n' ' ' < "$SCRATCH/land.out"))"; fi
[[ "$(on_main "$DEST")" == "$(cat "$ROSTER")" ]] && ok "main holds the built roster" || bad "main holds the built roster"
[[ "$(on_main moved.txt)" == "moved 1" ]] && ok "on top of both of the desk's pushes" || bad "on top of both of the desk's pushes ($(on_main moved.txt))"
grep -q "landed on its new tip on try 3" "$SCRATCH/land.out" && ok "and the log says which try" || bad "and the log says which try ($(tr '\n' ' ' < "$SCRATCH/land.out"))"

echo "A main that never stops moving"
fresh || bad "could not build the repositories"
echo 99 > "$SCRATCH/moves"
if raced; then bad "the landing gives up"; else ok "the landing gives up after its tries"; fi
[[ "$(on_main "$DEST")" != "$(cat "$ROSTER")" ]] && ok "main does not hold the roster, so the caller falls back" || bad "main does not hold the roster"
grep -q "after 4 tries" "$SCRATCH/land.out" && ok "and says how many tries it made" || bad "and says how many tries it made ($(tr '\n' ' ' < "$SCRATCH/land.out"))"

echo "A remote that refuses the push"
fresh || bad "could not build the repositories"
printf '#!/bin/sh\necho "refused by the test" >&2\nexit 1\n' > "$ORIGIN/hooks/pre-receive"
chmod +x "$ORIGIN/hooks/pre-receive"
if RUNNER_LAND_TRIES=2 land; then bad "the landing fails"; else ok "the landing fails, so the caller falls back"; fi
[[ "$(on_main "$DEST")" != "$(cat "$ROSTER")" ]] && ok "and main is as it was" || bad "and main is as it was"

echo "Every line whole, whatever quotes it carries"
seen() { printf '%s\n' "$1" >> "$SCRATCH/seen.txt"; }
export -f seen
export SCRATCH
lines="$SCRATCH/lines.txt"
{
    printf '%s\n' "one.example.test|A Plain Name|bumps_due"
    printf '%s\n' "two.example.test|Sam's Downtown Barbers|bumps_due"
    printf '\n'
    printf '%s\n' "three.example.test|The \"Best\" Roofers & Sons|visits_due"
    printf '%s\n' "four.example.test|After the Apostrophe|first_touch"
} > "$lines"
: > "$SCRATCH/seen.txt"
if runner_each_line 1 seen < "$lines" 2>"$SCRATCH/each.err"; then ok "the reader runs clean"; else bad "the reader runs clean ($(tr '\n' ' ' < "$SCRATCH/each.err"))"; fi
if [[ "$(cat "$SCRATCH/seen.txt")" == "$(sed '/^$/d' "$lines")" ]]; then
    ok "every line reaches the function whole, the ones after an apostrophe included"
else
    bad "every line reaches the function whole (got: $(tr '\n' ';' < "$SCRATCH/seen.txt"))"
fi
: > "$SCRATCH/seen.txt"
runner_each_line 3 seen < "$lines" 2>/dev/null
[[ "$(sort "$SCRATCH/seen.txt")" == "$(sed '/^$/d' "$lines" | sort)" ]] && ok "and in parallel too" || bad "and in parallel too"

echo
printf 'pass %d, fail %d\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
