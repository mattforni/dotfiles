#!/usr/bin/env bash
# Table test for .claude/hooks/worktree-gate.sh: every mutating git command
# aimed at a primary checkout is denied, typed or wrapped in a script the
# command runs, and every worktree commit, landing step, read, and unresolvable
# path is allowed. Builds throwaway repos in a temp dir. Run by CI and by hand;
# add a row for each new way the gate was walked around.
set -uo pipefail

REPO=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "not in a git repo"; exit 1; }
HOOK="$REPO/.claude/hooks/worktree-gate.sh"
[[ -x "$HOOK" ]] || { echo "hook missing or not executable: $HOOK"; exit 1; }

TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT
TMP=$(cd "$TMP" && pwd -P)

P="$TMP/primary"
WT="$TMP/primary-wt"
S="$TMP/scratch"
git init -q "$P" || exit 1
git -C "$P" -c user.name=t -c user.email=t commit -q --allow-empty -m init || exit 1
git -C "$P" worktree add -q "$WT" -b wt || exit 1
mkdir -p "$S"

printf 'git -C %s commit -m x\n' "$P" >"$S/primary.sh"
printf 'echo start\ncd %s\ngit commit -m x\n' "$P" >"$S/cd-primary.sh"
printf 'cd %s && git reset --hard\n' "$P" >"$S/cd-chain.sh"
printf 'git -C %s commit -m x\n' "$WT" >"$S/worktree.sh"
printf 'cd %s\ngit commit -m x\n' "$WT" >"$S/cd-worktree.sh"
# shellcheck disable=SC2016 # the variable is meant to reach the script unexpanded
printf 'git -C "$X" commit -m x\n' >"$S/variable.sh"
# shellcheck disable=SC2016
printf 'cd "$X"\ngit commit -m x\n' >"$S/cd-variable.sh"
printf 'git -C %s status\ngit -C %s stash list\n' "$P" "$P" >"$S/read-only.sh"
printf '# git -C %s commit -m x\n' "$P" >"$S/commented.sh"
printf '#!/usr/bin/env bash\ngit -C %s reset --hard\n' "$P" >"$S/runme"
printf 'import subprocess\nsubprocess.run(["git", "-C", "%s", "commit"])\ngit -C %s commit\n' "$P" "$P" >"$S/tool.py"
printf 'echo "then git checkout main"\nprintf "cd x && git reset --hard\\n"\n' >"$S/prints-git.sh"
printf 'echo "done" && git -C %s commit -m x\n' "$P" >"$S/print-chain.sh"
printf 'echo "done" && git -C "%s" commit -m "x"\n' "$P" >"$S/print-chain-quoted.sh"
printf "git -C '%s' reset --hard\n" "$P" >"$S/single-quoted.sh"
printf 'cd %s/missing\ngit commit -m x\n' "$TMP" >"$S/cd-missing.sh"
printf 'cd -P %s\ngit commit -m x\n' "$P" >"$S/cd-option.sh"
# The deny message's own recipe: a worktree made, entered, and committed in.
printf 'git -C %s worktree add %s/fresh -b fresh\ncd %s/fresh\ngit commit -m x\n' "$P" "$TMP" "$TMP" >"$S/recipe.sh"
chmod +x "$S/primary.sh" "$S/runme"

pass=0; fail=0
expect() {
  local want="$1" cwd="$2" cmd="$3" out decision
  out=$(jq -cn --arg c "$cmd" --arg d "$cwd" '{tool_name:"Bash",tool_input:{command:$c},cwd:$d}' | "$HOOK" 2>/dev/null)
  decision=$(jq -r '.hookSpecificOutput.permissionDecision // "allow"' <<<"${out:-{\}}" 2>/dev/null)
  if [[ "$decision" == "$want" ]]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    printf '  FAIL want %-5s got %-5s  (cwd %s)  %s\n' "$want" "$decision" "${cwd#"$TMP"/}" "$cmd"
  fi
}

# Typed commands, as the gate has always judged them.
expect deny  "$P"  "git commit -m x"
expect deny  "$P"  "git checkout -b feature"
expect deny  "$P"  "git stash"
expect deny  "$WT" "git -C $P commit -m x"
expect deny  "$WT" "git -C '$P' reset --hard"
expect allow "$WT" "git commit -m x"
expect allow "$P"  "git -C $WT commit -m x"
expect allow "$P"  "git merge --ff-only wt"
expect allow "$P"  "git pull --ff-only"
expect allow "$P"  "git stash list"
expect allow "$P"  "git status"
expect allow "$P"  "git -C $P worktree add $TMP/other -b other origin/main"
expect allow "$P"  "WT_GATE_BYPASS=1 git commit -m x"

# A typed cd moves the directory the git calls after it are judged in.
expect deny  "$WT" "cd $P && git commit -m x"
expect deny  "$WT" "cd '$P'; git reset --hard"
expect deny  "$WT" "cd $P && git status && git checkout -b feature"
expect deny  "$WT" "cd $WT && cd $P && git commit -m x"
expect allow "$P"  "cd $WT && git commit -m x"
expect allow "$WT" "cd $P && git -C $WT commit -m x"
expect allow "$WT" "cd $P && git status"
expect allow "$WT" "git commit -m x && cd $P"
expect deny  "$P"  "cd \"\$X\" && git commit -m x"
expect allow "$WT" "cd \"\$X\" && git commit -m x"
# A cd that fails leaves the shell where it was.
expect deny  "$P"  "cd $TMP/missing; git commit -m x"
expect allow "$WT" "cd $TMP/missing; git commit -m x"
expect deny  "$P"  "cd -; git commit -m x"
expect deny  "$P"  "cd \$(git rev-parse --show-toplevel) && git commit -m x"
expect deny  "$P"  "cd \`git rev-parse --show-toplevel\` && git commit -m x"
expect deny  "$P"  "cd && git commit -m x"
# Options to cd are not the target.
expect deny  "$WT" "cd -P $P && git commit -m x"
expect deny  "$WT" "cd -- $P && git commit -m x"
expect allow "$P"  "cd -L $WT && git commit -m x"
# A subshell's cd ends at its paren.
expect deny  "$P"  "(cd $WT && git commit -m x); git commit -m x"
expect deny  "$P"  "echo \$(cd $WT && pwd) && git commit -m x"
expect deny  "$WT" "(cd $P && git commit -m x)"
# Main's verdict is the floor: what it denies is lifted only for a plain
# command, so a cd hidden in a subshell, a pipe, a background job, or quoted
# text never lifts it.
expect deny  "$P"  "(cd $WT && git commit -m x)"
expect deny  "$P"  "cd $WT & git commit -m x"
expect deny  "$P"  "cd $WT | git commit -m x"
expect deny  "$P"  "echo \"next; cd $WT\"; git commit -m x"
expect deny  "$P"  "echo 'then cd $WT &&' && git commit -m x"
expect allow "$P"  "cd \"$WT\" && git commit -m \"a; b\""
expect allow "$P"  "cd '$WT' && git add -A && git commit -m 'x'"

# Scripts the command runs.
expect allow "$P"  "bash $S/prints-git.sh"
expect deny  "$WT" "bash $S/print-chain.sh"
expect deny  "$WT" "bash $S/print-chain-quoted.sh"
expect deny  "$WT" "bash $S/single-quoted.sh"
expect allow "$P"  "bash $S/cd-missing.sh"
expect allow "$P"  "bash $S/recipe.sh"
expect deny  "$WT" "bash $S/cd-option.sh"
expect deny  "$WT" "bash -c $S/primary.sh"
expect deny  "$WT" "bash -c '$S/primary.sh --flag'"
expect deny  "$WT" "sh -xc \"$S/primary.sh\""
expect deny  "$WT" "bash < $S/primary.sh"
expect deny  "$WT" "bash $S/primary.sh"
expect deny  "$WT" "sh -x $S/primary.sh"
expect deny  "$WT" "zsh '$S/primary.sh'"
expect deny  "$WT" "/bin/bash $S/primary.sh"
expect deny  "$WT" "source $S/primary.sh"
expect deny  "$WT" ". $S/primary.sh"
expect deny  "$WT" "$S/primary.sh"
expect deny  "$WT" "cd $S && ./primary.sh"
expect deny  "$WT" "cd $S && bash primary.sh 2>&1 | tail -5"
expect deny  "$WT" "echo hi; $S/primary.sh"
expect deny  "$WT" "FOO=1 env BAR=2 $S/primary.sh"
expect deny  "$WT" "out=\$($S/primary.sh)"
expect deny  "$WT" "$S/runme"
expect deny  "$WT" "bash $S/cd-primary.sh"
expect deny  "$WT" "bash $S/cd-chain.sh"
expect deny  "$P"  "bash $S/cd-worktree.sh && bash $S/primary.sh"
expect allow "$P"  "bash $S/worktree.sh"
expect allow "$P"  "bash $S/cd-worktree.sh"
expect allow "$P"  "bash $S/variable.sh"
expect allow "$P"  "bash $S/cd-variable.sh"
expect allow "$P"  "bash $S/read-only.sh"
expect allow "$P"  "bash $S/commented.sh"
expect allow "$WT" "python3 $S/tool.py"
expect allow "$WT" "bash $S/missing.sh"
expect allow "$WT" "WT_GATE_BYPASS=1 bash $S/primary.sh"

# Reading a script is not running it.
expect allow "$P"  "cat $S/primary.sh"
expect allow "$P"  "grep -n git $S/primary.sh"
expect allow "$P"  "shellcheck $S/primary.sh"
expect allow "$P"  "bash -n $S/worktree.sh"

# This test is itself a script full of quoted git commands; running it from a
# primary must pass.
expect allow "$P"  "$REPO/bin/lint/worktree-gate-test"

echo "worktree gate: $pass passed, $fail failed"
[[ $fail -eq 0 ]]
