#!/usr/bin/env bash
# Review a checkout with the claude reviewer and print one JSONL stream: a
# review_context line, finding lines (reviewer, severity, fileName, line,
# summary, failure_scenario), and one complete line (reviewer, ran, reason,
# findings, blocking, unrated, sha, seconds, files). The findings come from
# the /code-review skill and their severities from a short grading pass after
# it. The exit code is 0 only when the complete line says ran:true.
#
# Usage: review/run <worktree> [--base <ref>] [--effort low|medium|high|max]
#                   [--max-findings N] [--timeout <seconds>]
#
# It changes into the worktree itself (the one sanctioned cd, per GC) and
# reports the directory and HEAD in the review_context line, so the caller
# never needs a cd in its own command. The rules it enforces live in
# plugins/sdlc/reference/code-review.md.
set -euo pipefail

# shellcheck source=bin/review/lib.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# The default budget leaves room inside a 600 second Bash call for the fetch
# (30 s), the grading pass (60 s), two kill graces (15 s each), and process
# startup.
worktree=""; base=""; effort="high"; max=""; budget=450
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) base=$(value "$@") || exit 1; shift 2 ;;
    --effort) effort=$(value "$@") || exit 1; shift 2 ;;
    --max-findings) max=$(value "$@") || exit 1; shift 2 ;;
    --timeout) budget=$(value "$@") || exit 1; shift 2 ;;
    -h|--help) usage ;;
    -*) die "unknown option $1" ;;
    *) [[ -z "$worktree" ]] || die "one worktree only"; worktree="$1"; shift ;;
  esac
done
[[ -n "$worktree" ]] || usage 1
[[ -d "$worktree" ]] || die "no such directory: $worktree"
case "$effort" in low|medium|high|max) ;; *) die "--effort wants low, medium, high, or max, got $effort" ;; esac
[[ "$budget" =~ ^[0-9]+$ && "$budget" -ge 60 ]] || die "--timeout wants whole seconds, at least 60, got $budget"
[[ -z "$max" || "$max" =~ ^[0-9]+$ || "$max" == all ]] || die "--max-findings wants a number or all, got $max"
need jq; need git; need timeout

cd "$worktree" || die "cannot enter $worktree"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$worktree is not a git checkout"

# A stale base is a review of the wrong diff, so fetch, and say so if it fails
# rather than silently reviewing against yesterday's main.
fetch_note=""
timeout 30 git fetch -q origin 2>/dev/null || fetch_note="fetch failed; base may be stale"

if [[ -z "$base" ]]; then
  for candidate in "origin/$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')" origin/main origin/master; do
    [[ "$candidate" != "origin/" ]] || continue
    if git rev-parse -q --verify "$candidate^{commit}" >/dev/null 2>&1; then base="$candidate"; break; fi
  done
fi
[[ -n "$base" ]] || die "no base ref found; pass --base"

sha=$(git rev-parse HEAD)
files=$(git diff --name-only "$base...HEAD" | wc -l | tr -d ' ')
repo=$(git remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#' || true)
[[ -n "$repo" ]] || repo="$(basename "$(pwd -P)")"

jq -cn --arg wd "$(pwd -P)" --arg sha "$sha" --arg base "$base" --argjson files "$files" \
  --arg repo "$repo" --arg note "$fetch_note" \
  '{type:"review_context", workingDirectory:$wd, repo:$repo, sha:$sha, base:$base,
    files:$files, reviewers:["claude"], note:$note}'

if [[ "$files" -eq 0 ]]; then
  jq -cn --arg sha "$sha" '{type:"complete",reviewer:"claude",ran:false,reason:"no changes against base",findings:0,blocking:0,unrated:0,sha:$sha,seconds:0,files:0}'
  exit 1
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/review.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
state=$(review_state_dir)
stamp="$(date -u +%Y%m%dT%H%M%SZ)-${sha:0:8}"

# The reviewer writes raw, rc and seconds under its own directory and nothing
# inside the worktree. It is the built in /code-review skill,
# run headless with read only git tools; the effort is passed inside the
# command because a level typed in a -p run does not update the remembered
# one. The findings shape is asked for through the system prompt rather than
# --json-schema: the skill runs as a local command, and with a schema attached
# the run returned "Command completed" and no structured output (2026-10-07).
run_claude() {
  local dir="$1" start target
  mkdir -p "$dir"; start=$(date +%s)
  target="$effort $base...HEAD"
  [[ -z "$max" ]] || target+=" --max-findings $max"
  local rc=0
  timeout -k 15 "$budget" claude -p "/code-review $target" \
    --output-format json --append-system-prompt "$REVIEW_SHAPE_PROMPT" \
    --permission-mode dontAsk --no-session-persistence \
    --allowedTools "Read,Grep,Glob,Bash(git diff *),Bash(git log *),Bash(git show *),Bash(git blame *)" \
    </dev/null >"$dir/raw" 2>"$dir/err" || rc=$?
  echo "$rc" >"$dir/rc"
  echo $(( $(date +%s) - start )) >"$dir/seconds"
}

# Grade the findings in a stream: one grade each, from the finding's own text,
# with no tools. A grading run that fails leaves no usable grades.raw, and
# apply_grades then passes the stream through with every finding still major.
grade_claude() { # <stream.jsonl> <dir>
  local stream="$1" dir="$2" findings
  findings=$(jq -cs 'map(select(.type == "finding") | {file: .fileName, line, summary, failure_scenario})' "$stream")
  timeout -k 15 60 claude -p "$REVIEW_GRADE_PROMPT"$'\n\n'"$findings" \
    --output-format json --json-schema "$REVIEW_GRADE_SCHEMA" \
    --system-prompt "You grade code review findings and reply with the grades only." \
    --permission-mode dontAsk --no-session-persistence --tools "" \
    </dev/null >"$dir/grades.raw" 2>>"$dir/err" || true
}

dir="$tmp/claude"
run_claude "$dir"
secs=$(cat "$dir/seconds" 2>/dev/null || echo 0)
[[ -f "$dir/raw" ]] || : >"$dir/raw"
cp "$dir/raw" "$state/runs/$stamp-claude.raw" 2>/dev/null || true

# A normaliser that dies (a jq error on a shape nobody foresaw) must not take
# the stream with it: the review is reported as not run, and the raw copy
# under the state dir is there to look at.
out="$tmp/out.jsonl"
if ! normalise_claude "$dir/raw" "$(cat "$dir/rc" 2>/dev/null || echo 1)" "$sha" "$secs" "$files" >"$out"; then
  jq -cn --arg sha "$sha" --argjson secs "$secs" --argjson files "$files" \
    '{type:"complete",reviewer:"claude",ran:false,reason:"normaliser failed; raw kept under the state dir",findings:0,blocking:0,unrated:0,sha:$sha,seconds:$secs,files:$files}' >"$out"
fi

# Grade whatever arrived without a severity, which in practice is every
# finding. Nothing to grade, or a grading run that failed, leaves the stream
# as the normaliser wrote it.
if [[ "$(jq -cs 'map(select(.type == "complete")) | first | .unrated // 0' "$out")" -gt 0 ]]; then
  grade_claude "$out" "$dir"
  cp "$dir/grades.raw" "$state/runs/$stamp-grades.raw" 2>/dev/null || true
  if apply_grades "$out" "$dir/grades.raw" >"$tmp/graded.jsonl" && [[ -s "$tmp/graded.jsonl" ]]; then
    mv "$tmp/graded.jsonl" "$out"
  fi
fi

# One scorecard row, from the complete line.
line=$(jq -c 'select(.type == "complete")' "$out" | tail -n1)
scorecard_append "run" "$repo" "" "$sha" "claude" "$(jq -r '.ran' <<<"$line")" "$(jq -r '.reason' <<<"$line")" \
  "$(jq -r '.findings' <<<"$line")" "" "" "" "$(jq -r '.seconds' <<<"$line")" "$(jq -r '.blocking' <<<"$line")"

cat "$out"
[[ "$(jq -r '.ran' <<<"$line")" == "true" ]]
