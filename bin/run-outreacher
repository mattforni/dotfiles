#!/usr/bin/env bash
# Wrapper invoked by launchd (com.mattforni.outreacher) to run the outreacher
# agent headlessly every Monday morning, so the ATE-480 Weekly Outreach roster
# is rebuilt and drafted before the Tuesday desk block. Prep only: the agent
# never sends, never moves a Lead Status, never writes to a repo. Sends wait
# for Forni's explicit yes inside the block.
#
# Sends a Resend email after every run (success or failure) so reports survive
# silenced macOS notifications; falls back to osascript only when the email
# path itself fails. Email reporting lives in bin/lib/email-report.sh and is
# shared across all headless routines. Playbook: homebase's
# .claude/references/headless-claude.md.
#
# Auth: prefer the macOS Keychain entry (service "claude-code-oauth"), seeded
# once with `claude setup-token`. Falls back to a gitignored
# ~/.claude/.oauth-token file. With neither, claude uses its default login.
#
# Permissions: instead of --dangerously-skip-permissions, the invocation pre
# allows only the tools the agent needs. Each entry matches a single plain
# command; the agent is told to keep every Bash call that shape and to put
# multi step logic in a python script under the scratch dir.
#
# Usage: run-outreacher [--dry-run] [--reuse] [--week YYYY-Www] [--no-open]
#
#   --dry-run  render the email to the scratch dir and open it, sending nothing
#   --reuse    skip the agent and reuse the JSON the last run saved
#   --week     draft another week instead of the current one
#   --no-open  leave the rendered email on disk without opening a browser
#
# launchd passes no flags and gets the full run. The flags above are the local
# iterate loop, the same shape the Cloud Run runners have (runners/README.md,
# "Iterate Locally, Then Promote"): --dry-run --reuse re-renders the saved
# result in about a second with no network and no inbox, --dry-run alone runs
# the real agent and still sends nothing, and no flags at all is production.
set -uo pipefail

# $HOME/bin comes first because it holds the gws and hs shims, exactly the
# precedence .zshrc finalizes with; the mise shims directory is how a non
# interactive shell reaches what `mise activate` wires for an interactive one,
# and hs is an npm global under mise-managed node. Both were missing, so the
# 2026-08-31 run died in preflight on "hs not on PATH" and never reached the
# agent. Keep launchagents/com.mattforni.outreacher.plist in step with this.
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

ROUTINE="Outreacher"
LOG="$HOME/.claude/debug/outreacher.log"
TOKEN_FILE="$HOME/.claude/.oauth-token"
ATELIC="$HOME/Eudaimonia/Craft/Vocation/Atelic"
KEYCHAIN_SERVICE="claude-code-oauth"
SCRATCH="$HOME/.claude/debug/outreacher-scratch"

# The agent reads the method from the atelic repo, reads HubSpot through the
# hs CLI, both mailboxes through gws, verifies claims on the web, and writes
# one Linear issue. Nothing else. Widen only with a documented reason.
ALLOWED_TOOLS=(
  "Bash(hs:*)"
  "Bash(gws:*)"
  # Allow rules do not match past an env assignment they do not recognize, so
  # the profile pinned form the agent is told to use needs its own entries.
  "Bash(GWS_FORCE_PROFILE=atelic gws:*)"
  "Bash(GWS_FORCE_PROFILE=personal gws:*)"
  "Bash(linear:*)"
  "Bash(curl:*)"
  # The customer path walk runs in a real browser, never curl alone.
  "Bash(agent-browser:*)"
  "Bash(python3:*)"
  "Bash(security:*)"
  "Bash(date:*)"
  "Bash(cat:*)"
  "Bash(ls:*)"
  "Read"
  "Grep"
  "Glob"
  "WebFetch"
  "WebSearch"
  "Write($SCRATCH/*)"
)

ATTEMPT_TIMEOUT="45m"
MAX_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=15
TRANSIENT_SIGNATURE='socket connection was closed|API Error|overloaded|Connection error|terminated'

mkdir -p "$(dirname "$LOG")" "$SCRATCH"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EMAIL_LIB="$SCRIPT_DIR/lib/email-report.sh"
if [[ ! -r "$EMAIL_LIB" ]]; then
  echo "FATAL: email lib missing at $EMAIL_LIB" >&2
  osascript -e "display notification \"email lib missing\" with title \"$ROUTINE\"" >&2 || true
  exit 1
fi
# shellcheck source=lib/email-report.sh
source "$EMAIL_LIB"
# Set by email_report on failure; declared here so the reference is visible
# to the linter and to a sourced shell.
email_error=""

notify_failure() {
  local msg="$1"
  msg="${msg//\\/\\\\}"
  msg="${msg//\"/\\\"}"
  osascript -e "display notification \"$msg\" with title \"$ROUTINE\" subtitle \"failed at $(date '+%H:%M')\"" 2>>"$LOG" || true
}

fatal_report() {
  local reason="$1"
  echo "FATAL: $reason"
  local summary="<div style=\"background:#ffebee;border-left:4px solid #c62828;padding:10px 14px;border-radius:4px;margin:0 0 12px 0;\"><strong style=\"color:#b71c1c;\">$reason</strong></div>"
  if deliver "failure" "$summary" "" ""; then
    echo "email: report $delivery_verb ($reason)"
  else
    echo "email: failed: $email_error"
    notify_failure "$reason; email also failed: $email_error"
  fi
}

runtime_failure_report() {
  local reason="$1"
  if deliver "failure" "$summary_block" "$result_text" "$meta_block"; then
    echo "email: report $delivery_verb ($reason)"
  else
    echo "email: report failed: $email_error"
    notify_failure "$ROUTINE $reason; email also failed: $email_error"
  fi
}

load_oauth_token() {
  local token
  token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>>"$LOG") || token=""
  if [[ -n "$token" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$token"
    return 0
  fi
  if [[ -r "$TOKEN_FILE" ]]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(cat "$TOKEN_FILE")"
    export CLAUDE_CODE_OAUTH_TOKEN
    return 0
  fi
  return 1
}

# Sourcing exposes the helpers without firing the routine.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0 2>/dev/null || true
fi

DRY_RUN=0
REUSE=0
OPEN_IT=1
week_override=""
while (( $# )); do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --reuse)   REUSE=1; shift ;;
    --no-open) OPEN_IT=0; shift ;;
    --week)    week_override="${2:-}"; shift 2 ;;
    -h|--help) sed -n '/^# Usage:/,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *)         echo "run-outreacher: unknown option $1" >&2; exit 2 ;;
  esac
done

week="${week_override:-$(date +%G-W%V)}"
# The retro runner mails "YYYY-Www Retro". This is its sibling and reads the
# same way: both are weekly, so the week is the handle worth carrying, not the
# day the send happened to go out.
export EMAIL_REPORT_SUBJECT="$week Outreach"

delivery_verb="sent"
RESULT_FILE="$SCRATCH/result.json"
# The exit status rides in its own file because the failure worth replaying
# most often is a timeout, and a timeout leaves the result JSON empty. An
# empty file can carry no status, and its mere existence cannot be trusted as
# the marker that a run happened either, so this one is the marker.
RESULT_RC_FILE="$SCRATCH/result.rc"
REPORT_FILE="$SCRATCH/report.html"

# In a dry run the email is rendered and opened rather than sent, so the local
# loop can look at the thing before an inbox does. Every reporting path goes
# through here, failures included, because a failure report is the one most
# worth reading before it is trusted.
deliver() {
  if (( DRY_RUN )); then
    build_report_html "$1" "$2" "$3" "$4" > "$REPORT_FILE" || return 1
    echo "dry run: subject \"$EMAIL_REPORT_SUBJECT\""
    echo "dry run: rendered $REPORT_FILE"
    (( OPEN_IT )) && command -v open >/dev/null 2>&1 && open "$REPORT_FILE"
    delivery_verb="rendered"
    return 0
  fi
  delivery_verb="sent"
  email_report "$1" "$2" "$3" "$4"
}

run_routine() {
  echo ""
  echo "=== $(date -Iseconds) run-outreacher start ==="

  if ! cd "$ATELIC"; then
    fatal_report "atelic repo missing at $ATELIC"
    exit 1
  fi

  for tool in claude jq curl security timeout hs gws linear; do
    if ! command -v "$tool" &>/dev/null; then
      fatal_report "$tool not on PATH ($PATH)"
      exit 1
    fi
  done

  if load_oauth_token; then
    echo "auth: token loaded"
  else
    echo "auth: no token found in keychain or file; relying on claude default"
  fi

  prompt="Prep the ATE-480 Weekly Outreach roster for ISO week $week. Scratch directory for scripts and the roster file: $SCRATCH. Run the full method in your definition and end with the success line."

  if (( REUSE )); then
    if [[ ! -f "$RESULT_RC_FILE" ]]; then
      fatal_report "--reuse needs a saved run in $SCRATCH; run without it once"
      exit 1
    fi
    # Both halves come back, so a saved failure replays as that failure rather
    # than as a success that fails the predicate a moment later. Rendering the
    # wrong failure would be worse than rendering none: the whole reason to
    # replay a run locally is that the failure email is the one nobody has
    # ever read before trusting it.
    result="$(cat "$RESULT_FILE" 2>/dev/null)" || result=""
    rc="$(cat "$RESULT_RC_FILE")"
    [[ "$rc" =~ ^[0-9]+$ ]] || rc=1
    echo "reuse: replaying the run saved in $SCRATCH (exit $rc)"
  else

    stderr_file="$(dirname "$LOG")/outreacher-claude-stderr.txt"
    attempt=1
    while :; do
      echo "=== $(date -Iseconds) claude attempt $attempt/$MAX_ATTEMPTS (timeout $ATTEMPT_TIMEOUT) ==="
      result=$(timeout "$ATTEMPT_TIMEOUT" claude -p "$prompt" \
        --agent outreacher \
        --allowedTools "${ALLOWED_TOOLS[@]}" \
        --output-format json 2>"$stderr_file")
      rc=$?

      [[ $rc -eq 0 ]] && break

      transient=false
      if [[ $rc -eq 124 ]]; then
        transient=true
        echo "claude attempt $attempt timed out after $ATTEMPT_TIMEOUT"
      elif { printf '%s' "$result"; cat "$stderr_file" 2>/dev/null; } | grep -qiE "$TRANSIENT_SIGNATURE"; then
        transient=true
        echo "claude attempt $attempt hit a transient API error (exit $rc)"
      fi

      if [[ "$transient" == true && $attempt -lt $MAX_ATTEMPTS ]]; then
        echo "retrying in ${RETRY_BACKOFF_SECONDS}s"
        attempt=$((attempt + 1))
        sleep "$RETRY_BACKOFF_SECONDS"
        continue
      fi
      break
    done

    # Saved on every real run, successes and failures alike, so --reuse can
    # put the very same JSON and the very same exit status back through the
    # reporting path.
    printf '%s' "$result" > "$RESULT_FILE"
    printf '%s' "$rc" > "$RESULT_RC_FILE"
  fi

  echo "$result"
  echo "=== $(date -Iseconds) run-outreacher end (exit $rc) ==="

  meta_block=$(build_meta_block "$result" "$rc")
  summary_block=$(build_summary_block "$result" "$rc" "Outreach roster prepped")
  result_text=$(echo "$result" | jq -r '.result // ""' 2>>"$LOG")
  [[ -z "$result_text" ]] && result_text="$result"

  if [[ $rc -ne 0 ]]; then
    runtime_failure_report "claude exit $rc"
    exit "$rc"
  fi

  if ! echo "$result" | jq -e --arg week "$week" '.subtype == "success" and .is_error == false and ((.result // "") | contains("Outreach roster prepped for " + $week))' >>"$LOG" 2>&1; then
    runtime_failure_report "agent did not complete"
    exit 1
  fi

  if deliver "success" "$summary_block" "$result_text" "$meta_block"; then
    echo "email: success report $delivery_verb"
  else
    echo "email: success report failed: $email_error"
    notify_failure "$ROUTINE complete but email report failed: $email_error"
  fi

  echo "=== $(date -Iseconds) run-outreacher success confirmed ==="
}

if (( DRY_RUN || REUSE )); then
  # A local run is being watched, so it goes to the terminal as well as the log.
  run_routine 2>&1 | tee -a "$LOG"
  exit "${PIPESTATUS[0]}"
fi
run_routine >> "$LOG" 2>&1
