#!/usr/bin/env bash
# Print the runners a diff between two commits affects, one per line, sorted.
#
# Usage: changed [-C <repo>] <base> <head>
#        changed [-C <repo>] --all [<head>]
#
# This is what turns a merge into a promote: .github/workflows/promote.yml
# hands it the two ends of a push and promotes each name it prints. Nothing
# printed and exit zero means the push changed no image.
#
# The rules, which mirror what runner_build_context in lib.sh stages:
#   runners/lib/, runners/email/         every runner (both ship in every image)
#   runners/email/<name>.tsx             that runner alone: a bundle carries its
#                                        own runner's page and no other
#   bin/runner/promote, bin/runner/lib.sh  every runner (they decide what ships)
#   runners/<name>/                      that runner, unless every changed path
#                                        there is one that never ships (its
#                                        README, mounts, out/, .build/,
#                                        .env.local, and email/tst/)
#   .claude/agents/<x>.md                each runner whose agents manifest lists x
#   a path a manifest names              each runner whose context manifest has
#                                        it as a source, or whose agents manifest
#                                        brings an agent from it
#
# Without -C only runners in this repository are ever printed. One that lives
# in another repository is promoted by that repository's own workflow, which
# checks this one out and asks this same script about its own tree with -C:
# the runners are read from runners/<name>/ there, and its manifests name what
# else its images are built from. Asked that way the shared rules above match
# nothing, since those paths are this repository's, so a change here to
# runners/lib/ or runners/email/ is never an answer about a runner there.
#
# What an entrypoint reads from another repository at run time is in no image
# and so in no rule here: the retro runs the funnel rules from a clone of the
# repository that holds them, so a change there is live on its next run and
# promotes nothing.
#
# Runners and manifests are read from the tree at <head>, never from a list
# kept here, so a new runner is covered the day its Dockerfile lands. A base
# that is empty, all zeros, or not a commit this clone holds (a first push, a
# force push) means every runner, since there is nothing honest to diff
# against. -C names another repository, which is how the test drives this
# against a throwaway one.
set -euo pipefail

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
[[ -r "$LIB" ]] || { echo "cannot read $LIB" >&2; exit 1; }
# shellcheck source=lib.sh
. "$LIB"

usage="usage: ${0##*/} [-C <repo>] <base> <head> | --all [<head>]"
repo=""; all=0; first=""; second=""; count=0
while (( $# )); do
    case "$1" in
        -C)        repo="${2:-}"; [[ -n "$repo" ]] || die "-C needs a directory"; shift 2 ;;
        --all)     all=1; shift ;;
        -h|--help) sed -n '2,44p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option $1" ;;
        *)
            # An empty base is a real argument here (a workflow hands one over
            # on a first push), so positions are counted, never tested for
            # emptiness.
            count=$((count + 1))
            case "$count" in
                1) first="$1" ;;
                2) second="$1" ;;
                *) die "unexpected argument $1" ;;
            esac
            shift ;;
    esac
done

[[ -n "$repo" ]] || repo="$(runner_repo_root)"
if (( all )); then
    (( count <= 1 )) || die "$usage"
    base=""; head="${first:-HEAD}"
else
    (( count == 2 )) || die "$usage"
    base="$first"; head="$second"
fi

git -C "$repo" rev-parse --verify --quiet "$head^{commit}" >/dev/null \
    || die "head '$head' is not a commit in $repo"

# Every runner that has a Dockerfile at <head>. A runner without one is local
# only and promote refuses it by name, so it is never printed.
every="$(git -C "$repo" -c core.quotePath=false ls-tree -r --name-only "$head" -- runners \
    | sed -n 's|^runners/\([^/]*\)/Dockerfile$|\1|p' | sort -u)"

# An unusable base widens to everything instead of failing: the push still
# happened, and promoting too much is the safe side of that guess.
if (( ! all )); then
    # Empty, or nothing but zeros (the before of a branch's first push).
    case "$base" in
        *[!0]*) ;;
        *) all=1 ;;
    esac
    if (( ! all )) && ! git -C "$repo" rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
        all=1
    fi
fi

if (( all )); then
    [[ -z "$every" ]] || printf '%s\n' "$every"
    exit 0
fi

# A runner's agents manifest at <head>, through the same reader
# runner_build_context stages from, so a line the staging would ship (indented,
# say) is a line this matches. One `name=path` per line, the path empty for an
# agent that comes from .claude/agents.
manifest() {
    git -C "$repo" show "$head:runners/$1/agents" 2>/dev/null | runner_agent_names || true
}

# A runner's context manifest at <head>, one `source:dest` per line.
context() {
    git -C "$repo" show "$head:runners/$1/context" 2>/dev/null | runner_context_entries || true
}

# Usage: has_line <lines> <line>
# Whether a newline separated list holds a line, whole and exact. Matched in
# the shell and never by piping into grep -q: under pipefail a grep that
# exits on its first match can leave the writer dying of SIGPIPE, the
# pipeline then reads as a failure, and a real match is dropped in silence.
# With no pipe there is no race to lose.
has_line() {
    case "
$1
" in
        *"
$2
"*) return 0 ;;
    esac
    return 1
}

is_runner() { has_line "$every" "$1"; }

# Whether a path inside a runner's directory is one that never reaches its
# image. The list is the one runner_build_context excludes by, minus the
# agents and context manifests (they decide what ships, so they count), plus
# the README, which is staged and which no Dockerfile copies.
never_ships() {
    local rest="$1" e
    [[ "$rest" != README.md ]] || return 0
    # A runner that keeps its page in its own email/ folder keeps the page's
    # tests, fixtures and goldens under email/tst/. They are staged beside
    # the renderer, and the image's first stage copies one built file
    # forward, so they are inputs to no image, as runners/email/tst/ is not.
    [[ "$rest" != email/tst/* ]] || return 0
    for e in $RUNNER_CONTEXT_EXCLUDES; do
        [[ "$e" != agents && "$e" != context ]] || continue
        [[ "$rest" == "$e" || "$rest" == "$e"/* ]] && return 0
    done
    return 1
}

# What each runner's manifests reach for outside the rules below, as
# `runner<TAB>path` lines with the path from the top of the repository: a
# context source, and an agent brought by path. A manifest names these
# relative to the runner's directory and may climb out of it with `..`, so
# the path is folded by its text (there is no tree on disk at <head> to ask).
# A line that climbs out of the repository is dropped here; the staging is
# what refuses it.
watched=""
tab="$(printf '\t')"
while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        target="$(runner_lexical_path "runners/$name/${entry%%:*}")" || continue
        watched="$watched$name$tab$target
"
    done <<< "$(context "$name")"
    while IFS= read -r entry; do
        [[ -n "${entry#*=}" ]] || continue
        target="$(runner_lexical_path "runners/$name/${entry#*=}")" || continue
        watched="$watched$name$tab$target
"
    done <<< "$(manifest "$name")"
done <<< "$every"

# Whether runners/<x> is a runner's directory, at either end of the diff. Both
# ends, so the page of a runner that this very push removes is still read as
# that runner's page and not as a shared file of the renderer.
runner_tree() {
    git -C "$repo" cat-file -e "$head:runners/$1/entrypoint.sh" 2>/dev/null \
        || git -C "$repo" cat-file -e "$base:runners/$1/entrypoint.sh" 2>/dev/null
}

# The diff is tree against tree, so it is right whether or not base is an
# ancestor of head. Renames are listed as a delete and an add, which makes a
# file moved out of one runner and into another count against both. NUL
# separated, because git otherwise quotes and escapes a name with anything
# past ASCII in it, and a quoted path matches no rule below. Through a file
# so a failed diff is an error and not an empty list.
paths="$(mktemp)"
trap 'rm -f "$paths"' EXIT
git -C "$repo" diff -z --name-only --no-renames "$base" "$head" > "$paths" \
    || die "could not diff $base against $head in $repo"

everything=0; affected=""
while IFS= read -r -d '' path; do
    [[ -n "$path" ]] || continue
    # Beside the rules below and never instead of them: a manifest may name
    # a path any of them also covers.
    while IFS="$tab" read -r name target; do
        [[ -n "$name" ]] || continue
        if [[ "$target" == . || "$path" == "$target" || "$path" == "$target"/* ]]; then
            affected="$affected$name
"
        fi
    done <<< "$watched"
    case "$path" in
        bin/runner/promote|bin/runner/lib.sh|runners/lib/*)
            everything=1 ;;
        # The image's first stage builds one bundle from render.tsx and what it
        # imports, and only that file is copied forward. The tests, their
        # fixtures and the goldens are inputs to none of it.
        runners/email/tst/*|runners/email/fixtures/*|runners/email/goldens/*) ;;
        runners/email/node_modules/*|runners/email/dist/*) ;;
        # A runner's page is in that runner's bundle and in no other, since
        # each image's first stage builds render.tsx around one page. So
        # runners/email/<name>.tsx reaches the runner called <name>, and
        # nothing when that runner ships no image. Every other file here is
        # the renderer itself, or a helper any page may import, and reaches
        # them all.
        runners/email/*.tsx)
            page="${path#runners/email/}"
            page="${page%.tsx}"
            if [[ "$page" != */* ]] && runner_tree "$page"; then
                ! is_runner "$page" || affected="$affected$page
"
            else
                everything=1
            fi
            ;;
        runners/email/*)
            everything=1 ;;
        runners/*/*)
            rest="${path#runners/}"
            name="${rest%%/*}"
            rest="${rest#*/}"
            is_runner "$name" || continue
            never_ships "$rest" || affected="$affected$name
"
            ;;
        .claude/agents/*.md)
            agent="${path#.claude/agents/}"
            agent="${agent%.md}"
            [[ "$agent" != */* ]] || continue
            while IFS= read -r name; do
                [[ -n "$name" ]] || continue
                names="$(manifest "$name")"
                # `x=` is the reader's line for a bare `x`: the agent from
                # .claude/agents. A runner that brings its own `x` by path
                # does not ship this file, and its line does not match.
                if has_line "$names" "$agent="; then
                    affected="$affected$name
"
                fi
            done <<< "$every"
            ;;
    esac
done < "$paths"

if (( everything )); then
    [[ -z "$every" ]] || printf '%s\n' "$every"
    exit 0
fi

printf '%s' "$affected" | sort -u
