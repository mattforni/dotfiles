#!/usr/bin/env bash
# Execute a runner's Cloud Run job now and print what it logged.
#
# Usage: fire <runner-name> [--week YYYY-Www] [--lines N]
#
# This is production: whatever the runner does on a schedule, it does now, send
# included. A --week override is applied to the job, used for the one
# execution, and cleared again afterwards even when the run fails, so a test
# fire never leaves the scheduled job pinned to a week in the past.
set -euo pipefail

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
[[ -r "$LIB" ]] || { echo "cannot read $LIB" >&2; exit 1; }
# shellcheck source=lib.sh
. "$LIB"

name=""; week=""; lines=60
while (( $# )); do
    case "$1" in
        --week)    week="${2:-}"; shift 2 ;;
        --lines)   lines="${2:-60}"; shift 2 ;;
        -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option $1" ;;
        *)         [[ -z "$name" ]] || die "unexpected argument $1"; name="$1"; shift ;;
    esac
done

runner_dir "$name" >/dev/null
command -v gcloud >/dev/null 2>&1 || die "gcloud not found on PATH"

clear_week() {
    echo "clearing the WEEK override"
    gcloud run jobs update "$name" --project="$RUNNER_PROJECT" --region="$RUNNER_REGION" \
        --remove-env-vars=WEEK >/dev/null
}

if [[ -n "$week" ]]; then
    echo "pinning the job to $week for this execution"
    gcloud run jobs update "$name" --project="$RUNNER_PROJECT" --region="$RUNNER_REGION" \
        --update-env-vars="WEEK=$week" >/dev/null
    trap clear_week EXIT
fi

echo "firing $name"
gcloud run jobs execute "$name" --project="$RUNNER_PROJECT" --region="$RUNNER_REGION" --wait || true

echo
gcloud logging read \
    "resource.type=\"cloud_run_job\" AND resource.labels.job_name=\"$name\"" \
    --project="$RUNNER_PROJECT" --limit="$lines" --order=asc --format='value(textPayload)'
