#!/usr/bin/env bash
# Fetch one credential from the GCP Secret Manager vault.
#
# Usage: fetch-secret <name> [<version>]
#
# Prints the secret value to stdout and nothing else, so the caller captures
# or pipes it: `token="$(fetch-secret resend-api-key)"`. The project is
# resolved from the routing table in bin/lib/vault.sh, the same table the
# pushers and setup.sh use, so a local test reads the very secret a cloud
# runner is injected with. Version defaults to `latest`.
#
# This is the read half of bin/vault/push-secrets. It never echoes the value
# anywhere but stdout, never writes it to disk, and exits non zero with a
# reason on stderr when the vault is unreachable or the secret is missing.

set -euo pipefail

usage() {
    echo "usage: $(basename "$0") <secret-name> [<version>]" >&2
    exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
name="$1"
version="${2:-latest}"

VAULT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/vault.sh"
if [[ ! -r "$VAULT_LIB" ]]; then
    echo "cannot read $VAULT_LIB; there is no routing table to resolve $name" >&2
    exit 1
fi
# shellcheck source=../lib/vault.sh
. "$VAULT_LIB"

if ! command -v gcloud >/dev/null 2>&1; then
    echo "gcloud not found on PATH" >&2
    exit 1
fi

project="$(vault_project_for_secret "$name")"

# gcloud writes the value to stdout and its errors to stderr; both pass
# through untouched. A missing secret or an unreachable vault surfaces as
# gcloud's own message plus the routing decision, which is the detail a
# wrong account failure needs (the vaults answer to two identities).
if ! gcloud secrets versions access "$version" --secret="$name" --project="$project"; then
    echo "fetch-secret: could not read $name (version $version) from $project as $(gcloud config get-value account 2>/dev/null || echo unknown)" >&2
    exit 1
fi
