#!/usr/bin/env bash
# Push local credentials to the unified GCP Secret Manager vault.
#
# Vault: the "atelic" project (override via VAULT_PROJECT).
# Naming: kebab case, tool first, then auth type. A vault secret's name
# equals its macOS Keychain service name, verbatim, so there is never a
# mapping table between the local store and the cloud store.
#
# Source order per secret: Keychain service of the same name, then an
# environment variable fallback (name uppercased, dashes to underscores,
# e.g. linear-api-key -> LINEAR_API_KEY).
#
# Values flow stdin only: read into a shell variable, piped straight to
# gcloud --data-file=-; never echoed, never written to disk. Command
# substitution strips the trailing newline the Keychain read appends.
#
# The gws OAuth client files have their own pusher: bin/vault/push-gws-secrets.

set -euo pipefail

PROJECT="${VAULT_PROJECT:-atelic}"

SECRETS=(
    resend-api-key
    ynab-token
    atelic-token
    linear-api-key
    hubspot-service-key-tpf
)

if ! command -v gcloud >/dev/null 2>&1; then
    echo "gcloud not found on PATH" >&2
    exit 1
fi

if ! gcloud projects describe "$PROJECT" >/dev/null 2>&1; then
    echo "Vault project not found or not accessible: $PROJECT" >&2
    exit 1
fi

push_value() {
    # Reads the secret value on stdin; creates the secret on first push,
    # adds a version thereafter.
    local name="$1"
    if gcloud secrets describe "$name" --project="$PROJECT" >/dev/null 2>&1; then
        gcloud secrets versions add "$name" \
            --data-file=- \
            --project="$PROJECT" >/dev/null
        echo "updated $name"
    else
        gcloud secrets create "$name" \
            --replication-policy=automatic \
            --data-file=- \
            --project="$PROJECT" >/dev/null
        echo "created $name"
    fi
}

pushed=0
skipped=0
for name in "${SECRETS[@]}"; do
    value=""
    if ! value=$(security find-generic-password -s "$name" -w 2>/dev/null); then
        env_name=$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')
        value="${!env_name:-}"
    fi

    if [[ -z "$value" ]]; then
        echo "skip $name: not in Keychain and no env fallback set"
        skipped=$((skipped + 1))
        continue
    fi

    printf '%s' "$value" | push_value "$name"
    pushed=$((pushed + 1))
done

echo
echo "Done. Pushed: $pushed, skipped: $skipped (project: $PROJECT)"
