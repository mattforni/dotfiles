#!/usr/bin/env bash
# Push local credentials to the unified GCP Secret Manager vault.
#
# Vault: two projects, routed per credential by bin/lib/vault.sh. Business
# credentials go to the Atelic org's project, personal ones to the personal
# account's. Override either with VAULT_PROJECT_BUSINESS / VAULT_PROJECT_PERSONAL.
# Naming: kebab case, tool first, then auth type. A vault secret's name
# equals its macOS Keychain service name, verbatim, so there is never a
# mapping table between the local store and the cloud store.
#
# Source order per secret: Keychain service of the same name, then an
# environment variable fallback (name uppercased, dashes to underscores,
# e.g. linear-api-key -> LINEAR_API_KEY).
#
# Values flow stdin only: read into a shell variable, piped straight to
# gcloud --data-file=-; never echoed, never written to disk. Command
# substitution strips the trailing newline the Keychain read appends.
#
# The gws OAuth client files have their own pusher: bin/vault/push-gws-secrets.

set -euo pipefail

VAULT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/vault.sh"
if [[ ! -r "$VAULT_LIB" ]]; then
    echo "cannot read $VAULT_LIB; there is nowhere to push without it" >&2
    exit 1
fi
# shellcheck source=../lib/vault.sh
. "$VAULT_LIB"

# linear-api-key is gone: it was superseded by the workspace qualified names and
# destroyed in the 2026-08-14 vault split. linear-cli-* are not pushed from here
# because they live under one shared Keychain service rather than one per name.
SECRETS=(
    resend-api-key
    uptimerobot-api-key
    pinole-mcp-token
    hubspot-service-key-tpf
    ynab-token
    reclaim-api-key
)

if ! command -v gcloud >/dev/null 2>&1; then
    echo "gcloud not found on PATH" >&2
    exit 1
fi

for check_project in "$VAULT_PROJECT_BUSINESS" "$VAULT_PROJECT_PERSONAL"; do
    if ! gcloud projects describe "$check_project" >/dev/null 2>&1; then
        echo "Vault project not found or not accessible: $check_project" >&2
        exit 1
    fi
done

push_value() {
    # Reads the secret value on stdin; creates the secret on first push,
    # adds a version thereafter. The project comes from the routing table, so
    # a personal credential can never land in the business vault by omission.
    local name="$1"
    local project
    project="$(vault_project_for_secret "$name")"
    if gcloud secrets describe "$name" --project="$project" >/dev/null 2>&1; then
        gcloud secrets versions add "$name" \
            --data-file=- \
            --project="$project" >/dev/null
        echo "updated $name ($project)"
    else
        gcloud secrets create "$name" \
            --replication-policy=automatic \
            --data-file=- \
            --project="$project" >/dev/null
        echo "created $name ($project)"
    fi
}

pushed=0
skipped=0
for name in "${SECRETS[@]}"; do
    value=""
    if ! value=$(security find-generic-password -s "$name" -w 2>/dev/null); then
        env_name=$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')
        value="${!env_name:-}"
    fi

    if [[ -z "$value" ]]; then
        echo "skip $name: not in Keychain and no env fallback set"
        skipped=$((skipped + 1))
        continue
    fi

    printf '%s' "$value" | push_value "$name"
    pushed=$((pushed + 1))
done

echo
echo "Done. Pushed: $pushed, skipped: $skipped"
echo "Vaults: $VAULT_PROJECT_BUSINESS (business), $VAULT_PROJECT_PERSONAL (personal)"
