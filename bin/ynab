#!/usr/bin/env bash
# Dry run by default PATH shim around the real `ynab` (YNAB CLI) binary.
#
# Reads pass through untouched. Anything that mutates the budget refuses to run
# unless YNAB_APPLY=1 is set for that single invocation, and prints the command
# it would have run instead.
#
# Why this exists: the YNAB CLI has no read only mode and no --dry-run flag, so
# every write is live against real money the moment it is typed. The
# assist:handle-budget skill carries a dry run rule, but a skill rule is prose,
# and prose is the weakest form of a gate. This moves it into the tooling, where
# it holds for any caller: an agent, a headless run, or a hand typed command that
# was meant to be a read.
#
# It is a speed bump, not a security boundary. Anything that can set an
# environment variable can get past it. The point is that a write can never
# happen incidentally: it takes a second, deliberate act that says "yes, apply".
#
# Usage:
#   ynab transactions list --approved false      # read, runs
#   ynab transactions batch-update --transactions '[...]'   # refused, shows the command
#   YNAB_APPLY=1 ynab transactions batch-update --transactions '[...]'   # runs

set -euo pipefail

# Find the next `ynab` on PATH that isn't this shim. The -ef test compares by
# device and inode so reaching this script through ~/bin -> homebase/bin still
# matches, and the -d guard matters because a directory is also -x.
real_ynab=""
IFS=':' read -ra path_parts <<< "$PATH"
for p in "${path_parts[@]}"; do
    candidate="$p/ynab"
    if [[ -x "$candidate" && ! -d "$candidate" && ! "$candidate" -ef "$0" ]]; then
        real_ynab="$candidate"
        break
    fi
done
if [[ -z "$real_ynab" ]]; then
    echo "ynab shim: cannot find real ynab binary on PATH" >&2
    exit 127
fi

# Resolve the command group and verb, which are the first two bare words. Global
# flags may precede them, and -b/--budget carries a value that must not be
# mistaken for a positional.
group=""
verb=""
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then
        skip_next=0
        continue
    fi
    case "$arg" in
        -b|--budget) skip_next=1; continue ;;
        -*) continue ;;
    esac
    if [[ -z "$group" ]]; then
        group="$arg"
    elif [[ -z "$verb" ]]; then
        verb="$arg"
        break
    fi
done

# Everything that writes to the budget, enumerated from the CLI's own help
# rather than guessed. Local config (`budgets set-default`) and credential
# handling (`auth`) are deliberately absent: they touch this machine, not the
# money. A write to the wrong budget is still covered, because the write itself
# lands here.
mutates=0
case "$group/$verb" in
    transactions/create|transactions/update|transactions/delete|\
    transactions/split|transactions/batch-update|transactions/import|\
    categories/update|categories/budget|\
    payees/update|\
    scheduled/delete)
        mutates=1
        ;;
esac

if [[ $mutates -eq 1 && "${YNAB_APPLY:-}" != "1" ]]; then
    {
        echo "ynab shim: refusing a write in dry run mode."
        echo
        echo "  would run: ynab $*"
        echo
        echo "  This is a live mutation of a real budget, and the CLI has no"
        echo "  read only mode of its own. Re-run it prefixed with YNAB_APPLY=1"
        echo "  once the plan has been reviewed:"
        echo
        echo "    YNAB_APPLY=1 ynab $*"
    } >&2
    exit 1
fi

exec "$real_ynab" "$@"
